def _track_file_op(file_ops_tracker, tool_name, file_path, timestamp):
    if not file_path:
        return
    op_name = (tool_name or "").lower()
    if op_name not in ("read", "write", "edit", "glob", "grep"):
        return
    key = (file_path, op_name)
    ts_str = _ts_or_now(timestamp)
    if key in file_ops_tracker:
        file_ops_tracker[key]["last_at"] = ts_str
        file_ops_tracker[key]["count"] += 1
    else:
        file_ops_tracker[key] = {"first_at": ts_str, "last_at": ts_str, "count": 1}


def _classify_session_domain(domain_signals, file_ops_tracker):
    all_text = " ".join(domain_signals[:20])
    text_domain = classify_domain_from_text(all_text)
    path_domains = {}
    for (fp, _) in file_ops_tracker:
        d = classify_domain_from_path(fp)
        if d:
            path_domains[d] = path_domains.get(d, 0) + 1
    primary_domain = text_domain
    if path_domains:
        path_winner = max(path_domains, key=path_domains.get)
        if not primary_domain or path_domains[path_winner] > 3:
            primary_domain = path_winner
    all_domains = set()
    if text_domain:
        all_domains.add(text_domain)
    all_domains.update(path_domains.keys())
    domains_str = ",".join(sorted(all_domains)) if all_domains else None
    return primary_domain, domains_str


def _duration_ms(first_ts, last_ts):
    if not first_ts or not last_ts:
        return None
    try:
        dt_first = datetime.fromisoformat(first_ts)
        dt_last = datetime.fromisoformat(last_ts)
        return int((dt_last - dt_first).total_seconds() * 1000)
    except (ValueError, TypeError):
        return None


def _primary_model(models_seen):
    if not models_seen:
        return None
    for m in [
        "claude-opus-4-6",
        "claude-sonnet-4-5-20250929",
        "claude-haiku-4-5-20251001",
    ]:
        if m in models_seen:
            return m
    return next(iter(models_seen))


def _load_claude_summary(project_path, session_uuid, first_prompt):
    summary = None
    index_path = None
    if project_path:
        candidate = Path(project_path) / "sessions-index.json"
        if candidate.exists():
            index_path = candidate
    if index_path is None and SESSIONS_INDEX.exists():
        index_path = SESSIONS_INDEX
    if index_path is not None:
        try:
            idx_raw = json.loads(index_path.read_text())
            entries = []
            if isinstance(idx_raw, dict):
                entries = idx_raw.get("entries", [])
            elif isinstance(idx_raw, list):
                entries = idx_raw
            for entry in entries:
                if not isinstance(entry, dict):
                    continue
                if entry.get("sessionId") == session_uuid:
                    summary = entry.get("summary")
                    if not first_prompt and entry.get("firstPrompt"):
                        first_prompt = entry["firstPrompt"]
                    break
        except (json.JSONDecodeError, OSError):
            pass
    meta_file = get_usage_meta_dir() / f"{session_uuid}.json"
    if meta_file.exists():
        try:
            meta = json.loads(meta_file.read_text())
            if not summary and meta.get("summary"):
                summary = meta["summary"]
            if not first_prompt and meta.get("first_prompt"):
                first_prompt = meta["first_prompt"]
        except (json.JSONDecodeError, OSError):
            pass
    return summary, first_prompt


