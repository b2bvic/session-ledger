        row = conn.execute(
            "SELECT * FROM v_recent_sessions WHERE session_uuid LIKE ?",
            (f"{args.uuid}%",)
        ).fetchone()

        if not row:
            print(f"No session found matching: {args.uuid}")
            conn.close()
            return

        print(f"\nSession: {row['session_uuid']}")
        print(f"  Domain:    {row['primary_domain'] or '?'} ({row['domains'] or '?'})")
        print(f"  Started:   {row['started_at']}")
        print(f"  Duration:  {row['duration_min'] or '?'} min")
        print(f"  Model:     {row['primary_model'] or '?'}")
        print(f"  Messages:  {row['message_count']} ({row['tool_use_count']} tool calls)")
        print(f"  Tokens:    {row['total_input_tokens']:,} in / {row['total_output_tokens']:,} out")
        print(f"  Cost:      ${row['estimated_cost_usd']:.2f}")
        print(f"  Compacts:  {row['compact_count']}")
        print(f"  Subagents: {row['subagent_count']}")
        if row['first_prompt']:
            print(f"  Prompt:    {row['first_prompt'][:100]}...")
        if row['summary']:
            print(f"  Summary:   {row['summary'][:200]}...")

        # Show file operations
        files = conn.execute(
            "SELECT vault_relative, operation, operation_count FROM file_operations WHERE session_id = ? ORDER BY first_at",
            (row['id'],)
        ).fetchall()
        if files:
            print(f"\n  Files touched ({len(files)}):")
            for f in files[:20]:
                print(f"    {f['operation']:5s}  {f['vault_relative'] or '?'} (x{f['operation_count']})")
            if len(files) > 20:
                print(f"    ... and {len(files) - 20} more")

        # Show subagents
        agents = conn.execute(
            "SELECT slug, model, message_count, tool_use_count FROM subagents WHERE session_id = ?",
            (row['id'],)
        ).fetchall()
        if agents:
            print(f"\n  Subagents ({len(agents)}):")
            for a in agents:
                print(f"    {a['slug'] or '?'} ({a['model'] or '?'}) — {a['message_count']} msgs, {a['tool_use_count']} tools")

    elif args.subcmd == "concurrent":
        # Show concurrent session groups
        groups = conn.execute(
            """SELECT cg.*, GROUP_CONCAT(s.session_uuid || ' (' || COALESCE(s.primary_domain, '?') || ')', ' | ') AS members
               FROM concurrency_groups cg
               JOIN sessions s ON s.concurrency_group_id = cg.id
               GROUP BY cg.id ORDER BY cg.started_at DESC LIMIT ?""",
            (args.limit or 10,)
        ).fetchall()

        if not groups:
            print("No concurrent session groups found.")
        else:
            print(f"\n  Concurrent session groups:\n")
            for g in groups:
                print(f"  [{g['domains'] or '?'}] {g['started_at'][:16]} — {g['session_count']} sessions")
                for member in g['members'].split(' | '):
                    print(f"    {member}")
                print()

    else:
        # List sessions
        limit = args.limit or 20
        sql = "SELECT * FROM v_recent_sessions"
        params = []
        wheres = []

        if args.domain:
            wheres.append("primary_domain = ?")
            params.append(args.domain)
        if args.since:
            wheres.append("started_at >= ?")
            params.append(args.since)

        if wheres:
            sql += " WHERE " + " AND ".join(wheres)

        sql += f" LIMIT ?"
        params.append(limit)

        rows = conn.execute(sql, params).fetchall()

        if args.format == "json":
            print(json.dumps([dict(r) for r in rows], indent=2))
        else:
            print(f"\n  {'UUID':8s}  {'Domain':6s}  {'Date':10s}  {'Min':>4s}  {'Msgs':>5s}  {'Tools':>5s}  {'Cost':>7s}  Prompt")
            print(f"  {'─'*8}  {'─'*6}  {'─'*10}  {'─'*4}  {'─'*5}  {'─'*5}  {'─'*7}  {'─'*40}")
            for r in rows:
                uuid = r["session_uuid"][:8]
                domain = (r["primary_domain"] or "?")[:6]
                date = r["started_at"][:10] if r["started_at"] else "?"
                dur = str(r["duration_min"] or "?")
                msgs = str(r["message_count"])
                tools = str(r["tool_use_count"])
                cost = f"${r['estimated_cost_usd']:.2f}" if r["estimated_cost_usd"] else "$0.00"
                prompt = (r["first_prompt"] or "")[:40]
                print(f"  {uuid}  {domain:6s}  {date}  {dur:>4s}  {msgs:>5s}  {tools:>5s}  {cost:>7s}  {prompt}")

    conn.close()


