            return arguments
    return arguments


def _denormalize_tool_fields(inp):
    file_path = command = pattern = description = None
    if isinstance(inp, dict):
        file_path = inp.get("file_path") or inp.get("path")
        cmd = inp.get("command")
        if isinstance(cmd, list):
            command = " ".join(str(part) for part in cmd)
        elif isinstance(cmd, str):
            command = cmd
        pattern = inp.get("pattern")
        description = inp.get("description")
    return file_path, command, pattern, description


def harvest_jsonl(
    conn: sqlite3.Connection,
    jsonl_path: Path,
    dry_run: bool = False,
    force: bool = False,
    project_path=None,
    expected_provider=None,
) -> dict:
    """Harvest a single JSONL transcript into the database.

    Parse and identify the file before mutating rows. Resume of the same
    path is idempotent. A conflicting identity from a different path is
    rejected. Malformed input rolls back this file and leaves prior state.
    """
    stats = empty_harvest_stats()
    fhash = file_sha256(jsonl_path)
    if expected_provider != "codex":
        family = discover_subagent_files(jsonl_path)
        if family:
            digest = hashlib.sha256(fhash.encode())
            for child in family:
                digest.update(str(child.relative_to(jsonl_path.parent)).encode())
                digest.update(file_sha256(child).encode())
            fhash = digest.hexdigest()
    fsize = jsonl_path.stat().st_size
    fmtime = datetime.fromtimestamp(jsonl_path.stat().st_mtime, tz=timezone.utc).isoformat()

    if not force:
        existing_log = conn.execute(
            "SELECT id FROM harvest_log WHERE file_path = ? AND file_hash = ? AND status = 'complete'",
            (str(jsonl_path), fhash),
        ).fetchone()
        if existing_log:
            stats["skipped"] = True
            stats["status"] = "skipped"
            return stats

    if dry_run:
        stats["skipped"] = True
        stats["status"] = "skipped"
        return stats

    lines, decode_errors = load_jsonl_records(jsonl_path)
    stats["errors"] += decode_errors
    if decode_errors:
        stats["status"] = "error"
        return stats

    if not lines:
        stats["status"] = "error" if decode_errors else "unknown_format"
        stats["unknown_format"] = not decode_errors
        return stats

    fmt = detect_transcript_format(lines)
    if fmt == "unknown":
        stats["unknown_format"] = True
        stats["status"] = "unknown_format"
        return stats
    if expected_provider and fmt != expected_provider:
        stats["unknown_format"] = True
        stats["status"] = "unknown_format"
        return stats

    if fmt == "codex":
        native_id = extract_codex_session_id(lines)
        if not native_id:
            stats["unknown_format"] = True
            stats["status"] = "unknown_format"
            return stats
        provider = "codex"
        session_uuid = qualify_id("codex", native_id)
        parent_id = None
        for rec in lines:
            if isinstance(rec, dict) and rec.get("type") == "session_meta":
                payload = _payload(rec) or rec
                parent_native = payload.get("parent_id") or payload.get("parent_session_id") or payload.get("forked_from_id")
                if parent_native:
                    parent_id = qualify_id("codex", parent_native)
                break
    else:
        provider = "claude-code"
        source_ids = {str(row["sessionId"]) for row in lines if row.get("sessionId")}
        if len(source_ids) > 1:
            stats["status"] = "conflict"
            stats["conflict"] = True
            return stats
        native_id = next(iter(source_ids)) if source_ids else jsonl_path.stem
        session_uuid = native_id
        parent_id = None

    stats["session_uuid"] = session_uuid
    stats["provider"] = provider

    existing_session = conn.execute(
        "SELECT id, jsonl_path, source_path FROM sessions WHERE session_uuid = ? AND source = ?",
        (session_uuid, provider),
    ).fetchone()
    if existing_session:
        existing_path = existing_session["source_path"] or existing_session["jsonl_path"]
        if existing_path and _norm_path(existing_path) != _norm_path(jsonl_path) and Path(existing_path).exists():
            stats["conflict"] = True
            stats["status"] = "conflict"
            return stats

    conn.execute("SAVEPOINT harvest_file")
    try:
        if fmt == "codex":
            _harvest_codex_into(
                conn,
                jsonl_path,
                lines,
                stats,
                existing_session,
                session_uuid,
                native_id,
                parent_id,
                project_path,
                fhash,
                fsize,
                fmtime,
            )
        else:
            _harvest_claude_into(
                conn,
                jsonl_path,
                lines,
                stats,
                existing_session,
                session_uuid,
                project_path,
                fhash,
                fsize,
                fmtime,
            )
        conn.execute("RELEASE SAVEPOINT harvest_file")
    except Exception:
        conn.execute("ROLLBACK TO SAVEPOINT harvest_file")
        conn.execute("RELEASE SAVEPOINT harvest_file")
        raise
    return stats


def _harvest_claude_into(
    conn,
    jsonl_path,
    lines,
    stats,
    existing_session,
    session_uuid,
    project_path,
    fhash,
    fsize,
    fmtime,
):
    first_ts = None
    last_ts = None
    models_seen = set()
    version = None
    first_prompt = None
    domain_signals = []
    total_input = 0
    total_output = 0
    total_cache_create = 0
    total_cache_read = 0
    user_count = 0
    assistant_count = 0
    tool_count = 0
    compact_count = 0
    pending_tool_uses = {}
    file_ops_tracker = {}
    source_path = str(jsonl_path)
    project_str = str(project_path) if project_path else str(jsonl_path.parent)

    session_id = _open_session_row(
        conn,
        session_uuid=session_uuid,
        source="claude-code",
        provider="claude-code",
        native_session_id=session_uuid,
        parent_id=None,
        project_path=project_str,
        jsonl_path=jsonl_path,
        started_at=_ts_or_now(None),
        raw_line_count=len(lines),
        existing=existing_session,
    )

    def bump_ts(timestamp):
        nonlocal first_ts, last_ts
        if not timestamp:
            return
        if first_ts is None or timestamp < first_ts:
            first_ts = timestamp
        if last_ts is None or timestamp > last_ts:
            last_ts = timestamp

    for seq_num, record in enumerate(lines):
        if not isinstance(record, dict):
            continue
        rtype = record.get("type")
        timestamp = parse_timestamp(record.get("timestamp"))
        bump_ts(timestamp)
        native_msg = record.get("uuid")
        parent_msg = record.get("parentUuid")
        agent_id = record.get("agentId")
        agent_slug = record.get("agentSlug") or record.get("slug")

        if rtype == "user":
            msg = record.get("message", {})
            content = msg.get("content")
            content_text = extract_text_content(content)
            is_sidechain = 1 if record.get("isSidechain") else 0
            if record.get("version"):
                version = record["version"]
            tool_results = extract_tool_results(content) if isinstance(content, list) else []
            if tool_results:
                for tr in tool_results:
                    msg_id = _insert_message(
                        conn,
                        session_id=session_id,
                        uuid=native_msg,
                        native_id=native_msg,
                        parent_uuid=parent_msg,
                        timestamp=_ts_or_now(timestamp),
                        role="tool_result",
                        message_type="user",
                        content_text=tr["content"][:5000],
                        content_json=json.dumps(content) if content else None,
                        raw_json=json.dumps(record),
                        sequence_num=seq_num,
                        source_path=source_path,
                        is_sidechain=is_sidechain,
                        agent_id=agent_id,
                        agent_slug=agent_slug,
                    )
                    stats["messages"] += 1
                    tuid = tr["tool_use_id"]
                    if tuid in pending_tool_uses:
                        conn.execute(
                            "UPDATE tool_uses SET result_message_id = ?, result_text = ?, is_error = ? WHERE id = ?",
                            (
                                msg_id,
                                tr["content"][:10000],
                                1 if tr["is_error"] else 0,
                                pending_tool_uses[tuid],
                            ),
                        )
                        del pending_tool_uses[tuid]
            else:
                if not record.get("isMeta") and content_text and first_prompt is None:
                    first_prompt = content_text[:500]
                    domain_signals.append(content_text)
                if not record.get("isMeta") and content_text:
                    user_count += 1
                    domain_signals.append(content_text)
                _insert_message(
                    conn,
                    session_id=session_id,
                    uuid=native_msg,
                    native_id=native_msg,
                    parent_uuid=parent_msg,
                    timestamp=_ts_or_now(timestamp),
                    role="user",
                    message_type="user",
                    content_text=content_text,
                    content_json=json.dumps(content) if isinstance(content, list) else None,
                    raw_json=json.dumps(record),
                    sequence_num=seq_num,
                    source_path=source_path,
                    is_sidechain=is_sidechain,
                    agent_id=agent_id,
                    agent_slug=agent_slug,
                )
                stats["messages"] += 1

        elif rtype == "assistant":
            msg = record.get("message", {})
            content = msg.get("content", [])
            content_text = extract_text_content(content)
            model = msg.get("model")
            usage = msg.get("usage", {}) if isinstance(msg.get("usage"), dict) else {}
            if model and model != "<synthetic>":
                models_seen.add(model)
            in_tok = usage.get("input_tokens", 0) or 0
            out_tok = usage.get("output_tokens", 0) or 0
            cc_tok = usage.get("cache_creation_input_tokens", 0) or 0
            cr_tok = usage.get("cache_read_input_tokens", 0) or 0
            total_input += in_tok
            total_output += out_tok
            total_cache_create += cc_tok
            total_cache_read += cr_tok
            assistant_count += 1
            msg_id = _insert_message(
                conn,
                session_id=session_id,
                uuid=native_msg,
                native_id=native_msg,
                parent_uuid=parent_msg,
                timestamp=_ts_or_now(timestamp),
                role="assistant",
                message_type="assistant",
                content_text=content_text,
                content_json=json.dumps(content) if isinstance(content, list) else None,
                raw_json=json.dumps(record),
                sequence_num=seq_num,
                source_path=source_path,
                model=model,
                request_id=msg.get("id"),
                stop_reason=msg.get("stop_reason"),
                input_tokens=in_tok,
                output_tokens=out_tok,
                cache_create_tokens=cc_tok,
                cache_read_tokens=cr_tok,
                is_sidechain=1 if record.get("isSidechain") else 0,
                agent_id=agent_id,
                agent_slug=agent_slug,
            )
            stats["messages"] += 1
            if content_text:
                domain_signals.append(content_text)
            for tu in extract_tool_uses_from_content(content):
                tool_count += 1
                tu_id = _insert_tool_use(
                    conn,
                    message_id=msg_id,
                    session_id=session_id,
                    tool_use_id=tu["tool_use_id"],
                    native_id=tu["tool_use_id"],
                    tool_name=tu["tool_name"],
                    input_obj=tu["input"],
                    timestamp=_ts_or_now(timestamp),
                    file_path=tu.get("file_path"),
                    command=tu.get("command"),
                    pattern=tu.get("pattern"),
                    description=tu.get("description"),
                )
                pending_tool_uses[tu["tool_use_id"]] = tu_id
                stats["tool_uses"] += 1
                _track_file_op(file_ops_tracker, tu["tool_name"], tu.get("file_path"), timestamp)

        elif rtype == "system":
            subtype = record.get("subtype")
            if subtype == "compact_boundary":
                compact_count += 1
                summary_content = record.get("summary")
                if isinstance(summary_content, list):
                    summary_content = extract_text_content(summary_content)
                elif isinstance(summary_content, str):
                    pass
                else:
                    summary_content = None
                msg_id = _insert_message(
                    conn,
                    session_id=session_id,
                    uuid=native_msg,
                    native_id=native_msg,
                    parent_uuid=parent_msg,
                    timestamp=_ts_or_now(timestamp),
                    role="system",
                    message_type="system",
                    content_text=summary_content,
                    content_json=None,
                    raw_json=json.dumps(record),
                    sequence_num=seq_num,
                    source_path=source_path,
                    subtype=subtype,
                    is_compact_summary=1,
                    agent_id=agent_id,
                    agent_slug=agent_slug,
                )
                if summary_content:
                    conn.execute(
                        "INSERT INTO compactions (session_id, message_id, pre_tokens, summary_text, timestamp) VALUES (?, ?, ?, ?, ?)",
                        (
                            session_id,
                            msg_id,
                            record.get("preTokens"),
                            summary_content,
                            _ts_or_now(timestamp),
                        ),
                    )
            else:
                _insert_message(
                    conn,
                    session_id=session_id,
                    uuid=native_msg,
                    native_id=native_msg,
                    parent_uuid=parent_msg,
                    timestamp=_ts_or_now(timestamp),
                    role="system",
                    message_type="system",
                    content_text=str(record.get("content", ""))[:1000],
                    content_json=None,
                    raw_json=json.dumps(record),
                    sequence_num=seq_num,
                    source_path=source_path,
                    subtype=subtype,
                    agent_id=agent_id,
                    agent_slug=agent_slug,
                )
            stats["messages"] += 1

    _insert_file_ops(conn, session_id, file_ops_tracker, stats)
    primary_domain, domains_str = _classify_session_domain(domain_signals, file_ops_tracker)
    primary_model = _primary_model(models_seen)
    total_cost = 0.0
    if primary_model:
        total_cost = estimate_cost(
            primary_model,
            total_input,
            total_output,
            total_cache_create,
            total_cache_read,
        )
    summary, first_prompt = _load_claude_summary(project_str, session_uuid, first_prompt)

    subagent_files = discover_subagent_files(jsonl_path)
    subagent_count = 0
    seq_base = len(lines)
    for sa_file in subagent_files:
        agent_id = _agent_id_from_subagent_path(sa_file)
        conn.execute("SAVEPOINT harvest_subagent")
        try:
            sa_stats = _harvest_subagent_file(
                conn,
                session_id,
                sa_file,
                agent_id,
                seq_base,
                pending_tool_uses,
                file_ops_tracker,
                domain_signals,
            )
            conn.execute("RELEASE SAVEPOINT harvest_subagent")
        except (OSError, sqlite3.Error, json.JSONDecodeError, ValueError) as exc:
            conn.execute("ROLLBACK TO SAVEPOINT harvest_subagent")
            conn.execute("RELEASE SAVEPOINT harvest_subagent")
            raise ValueError(f"Subagent harvest failed; prior session preserved: {sa_file.name}") from exc
        seq_base += sa_stats.get("records", 0)
        stats["messages"] += sa_stats["messages"]
        stats["tool_uses"] += sa_stats["tool_uses"]
        stats["errors"] += sa_stats["errors"]
        user_count += sa_stats["user_count"]
        assistant_count += sa_stats["assistant_count"]
        tool_count += sa_stats["tool_count"]
        if sa_stats["model"]:
            models_seen.add(sa_stats["model"])
        conn.execute(
            """INSERT OR REPLACE INTO subagents
               (session_id, agent_id, slug, model, jsonl_path,
                message_count, tool_use_count, input_tokens, output_tokens,
                started_at, ended_at)
               VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
            (
                session_id,
                agent_id,
                sa_stats["slug"],
                sa_stats["model"],
                str(sa_file),
                sa_stats["sa_msgs"],
                sa_stats["sa_tools"],
                sa_stats["sa_in"],
                sa_stats["sa_out"],
                sa_stats["first_ts"],
                sa_stats["last_ts"],
            ),
        )
        subagent_count += 1

    _finalize_session_row(
        conn,
        session_id,
        first_ts=first_ts,
        last_ts=last_ts,
        primary_domain=primary_domain,
        domains_str=domains_str,
        summary=summary,
        primary_model=primary_model,
        models_seen=models_seen,
        version=version,
        total_input=total_input,
        total_output=total_output,
        total_cache_create=total_cache_create,
        total_cache_read=total_cache_read,
        total_cost=total_cost,
        stats=stats,
        user_count=user_count,
        assistant_count=assistant_count,
        tool_count=tool_count,
        file_ops_tracker=file_ops_tracker,
        compact_count=compact_count,
        subagent_count=subagent_count,
        first_prompt=first_prompt,
        line_count=len(lines),
    )
    _write_complete_harvest_log(
        conn, jsonl_path, fhash, fsize, fmtime, session_uuid, "claude-code", len(lines), stats["messages"]
    )


def _harvest_subagent_file(
    conn,
    session_id,
    sa_file: Path,
    agent_id: str,
    seq_base: int,
    pending_tool_uses: dict,
    file_ops_tracker: dict,
    domain_signals: list,
) -> dict:
    """Ingest nested Claude subagent JSONL into the parent session."""
    result = {
        "messages": 0,
        "tool_uses": 0,
        "errors": 0,
        "user_count": 0,
        "assistant_count": 0,
        "tool_count": 0,
        "sa_msgs": 0,
        "sa_tools": 0,
        "sa_in": 0,
        "sa_out": 0,
        "slug": None,
        "model": None,
        "first_ts": None,
        "last_ts": None,
        "records": 0,
    }
    lines, decode_errors = load_jsonl_records(sa_file)
    result["errors"] += decode_errors
    if decode_errors:
        raise ValueError("Malformed subagent transcript; prior session preserved")
    result["records"] = len(lines)
    source_path = str(sa_file)
    for seq_num, record in enumerate(lines):
        if not isinstance(record, dict):
            continue
        if record.get("slug") and not result["slug"]:
            result["slug"] = record["slug"]
        rtype = record.get("type")
        timestamp = parse_timestamp(record.get("timestamp"))
        if timestamp:
            if result["first_ts"] is None or timestamp < result["first_ts"]:
                result["first_ts"] = timestamp
            if result["last_ts"] is None or timestamp > result["last_ts"]:
                result["last_ts"] = timestamp
        native_msg = record.get("uuid")
        parent_msg = record.get("parentUuid")
        rec_agent = record.get("agentId") or agent_id
        agent_slug = record.get("agentSlug") or record.get("slug") or result["slug"]
        if rtype in ("user", "assistant"):
            result["sa_msgs"] += 1
        if rtype == "user":
            msg = record.get("message", {})
            content = msg.get("content")
            content_text = extract_text_content(content)
            tool_results = extract_tool_results(content) if isinstance(content, list) else []
            if tool_results:
                for tr in tool_results:
                    msg_id = _insert_message(
                        conn,
                        session_id=session_id,
                        uuid=native_msg,
                        native_id=native_msg,
                        parent_uuid=parent_msg,
                        timestamp=_ts_or_now(timestamp),
                        role="tool_result",
                        message_type="user",
                        content_text=tr["content"][:5000],
                        content_json=json.dumps(content) if content else None,
                        raw_json=json.dumps(record),
                        sequence_num=seq_base + seq_num,
                        source_path=source_path,
                        is_sidechain=1,
                        agent_id=rec_agent,
                        agent_slug=agent_slug,
                    )
                    result["messages"] += 1
                    tuid = tr["tool_use_id"]
                    if tuid in pending_tool_uses:
                        conn.execute(
                            "UPDATE tool_uses SET result_message_id = ?, result_text = ?, is_error = ? WHERE id = ?",
                            (
                                msg_id,
                                tr["content"][:10000],
                                1 if tr["is_error"] else 0,
                                pending_tool_uses[tuid],
                            ),
                        )
            elif content_text:
                result["user_count"] += 1
                _insert_message(
                    conn,
                    session_id=session_id,
                    uuid=native_msg,
                    native_id=native_msg,
                    parent_uuid=parent_msg,
                    timestamp=_ts_or_now(timestamp),
                    role="user",
                    message_type="user",
                    content_text=content_text,
                    content_json=json.dumps(content) if isinstance(content, list) else None,
                    raw_json=json.dumps(record),
                    sequence_num=seq_base + seq_num,
                    source_path=source_path,
                    is_sidechain=1,
                    agent_id=rec_agent,
                    agent_slug=agent_slug,
                )
                result["messages"] += 1
                domain_signals.append(content_text)
        elif rtype == "assistant":
            msg = record.get("message", {})
            content = msg.get("content", [])
            content_text = extract_text_content(content)
            model = msg.get("model")
            usage = msg.get("usage", {}) if isinstance(msg.get("usage"), dict) else {}
            if model:
                result["model"] = model
            result["sa_in"] += usage.get("input_tokens", 0) or 0
            result["sa_out"] += usage.get("output_tokens", 0) or 0
            result["assistant_count"] += 1
            msg_id = _insert_message(
                conn,
                session_id=session_id,
                uuid=native_msg,
                native_id=native_msg,
                parent_uuid=parent_msg,
                timestamp=_ts_or_now(timestamp),
                role="assistant",
                message_type="assistant",
                content_text=content_text,
                content_json=json.dumps(content) if isinstance(content, list) else None,
                raw_json=json.dumps(record),
                sequence_num=seq_base + seq_num,
                source_path=source_path,
                model=model,
                request_id=msg.get("id"),
                stop_reason=msg.get("stop_reason"),
                input_tokens=usage.get("input_tokens", 0) or 0,
                output_tokens=usage.get("output_tokens", 0) or 0,
                cache_create_tokens=usage.get("cache_creation_input_tokens", 0) or 0,
                cache_read_tokens=usage.get("cache_read_input_tokens", 0) or 0,
                is_sidechain=1,
                agent_id=rec_agent,
                agent_slug=agent_slug,
            )
            result["messages"] += 1
            if content_text:
                domain_signals.append(content_text)
            for tu in extract_tool_uses_from_content(content):
                result["tool_count"] += 1
                result["sa_tools"] += 1
                tu_id = _insert_tool_use(
                    conn,
                    message_id=msg_id,
                    session_id=session_id,
                    tool_use_id=tu["tool_use_id"],
                    native_id=tu["tool_use_id"],
                    tool_name=tu["tool_name"],
                    input_obj=tu["input"],
                    timestamp=_ts_or_now(timestamp),
                    file_path=tu.get("file_path"),
                    command=tu.get("command"),
                    pattern=tu.get("pattern"),
                    description=tu.get("description"),
                )
                pending_tool_uses[tu["tool_use_id"]] = tu_id
                result["tool_uses"] += 1
                _track_file_op(file_ops_tracker, tu["tool_name"], tu.get("file_path"), timestamp)
    return result


def _harvest_codex_into(
    conn,
    jsonl_path,
    lines,
    stats,
    existing_session,
    session_uuid,
    native_id,
    parent_id,
    project_path,
    fhash,
    fsize,
    fmtime,
):
    first_ts = None
    last_ts = None
    models_seen = set()
    version = None
    first_prompt = None
    cwd = None
    total_input = 0
    total_output = 0
    total_cache_create = 0
    total_cache_read = 0
    user_count = 0
    assistant_count = 0
    tool_count = 0
    pending_tool_uses = {}
    file_ops_tracker = {}
    domain_signals = []
    response_texts = {extract_text_content(_payload(r).get("content")) for r in lines
                      if r.get("type") == "response_item" and _payload(r).get("type") == "message"
                      and _payload(r).get("role") == "assistant"}
    source_path = str(jsonl_path)

    for record in lines:
        if not isinstance(record, dict) or record.get("type") != "session_meta":
            continue
        payload = _payload(record) or record
        cwd = payload.get("cwd") or payload.get("project_path") or cwd
        version = payload.get("cli_version") or payload.get("version") or version
        if payload.get("model"):
            models_seen.add(payload["model"])
        ts = parse_timestamp(record.get("timestamp") or payload.get("timestamp"))
        if ts:
            first_ts = ts if first_ts is None or ts < first_ts else first_ts
            last_ts = ts if last_ts is None or ts > last_ts else last_ts

    project_str = str(project_path) if project_path else cwd
    session_id = _open_session_row(
        conn,
        session_uuid=session_uuid,
        source="codex",
        provider="codex",
        native_session_id=native_id,
        parent_id=parent_id,
        project_path=project_str,
        jsonl_path=jsonl_path,
        started_at=_ts_or_now(first_ts),
        raw_line_count=len(lines),
        existing=existing_session,
    )

    def bump_ts(timestamp):
        nonlocal first_ts, last_ts
        if not timestamp:
            return
        if first_ts is None or timestamp < first_ts:
            first_ts = timestamp
        if last_ts is None or timestamp > last_ts:
            last_ts = timestamp

    def remember_tool(native_call_id, tu_id):
        if not native_call_id:
            return
        pending_tool_uses[str(native_call_id)] = tu_id
        pending_tool_uses[qualify_id("codex", native_call_id)] = tu_id

    for seq_num, record in enumerate(lines):
        if not isinstance(record, dict):
            continue
        rtype = record.get("type")
        payload = _payload(record)
        timestamp = parse_timestamp(record.get("timestamp") or payload.get("timestamp"))
        bump_ts(timestamp)

        if rtype == "session_meta":
            continue

        if rtype == "turn_context":
            model = payload.get("model")
            if model:
                models_seen.add(model)
            continue

        if rtype == "response_item":
            item_type = payload.get("type")
            if item_type == "message":
                role = payload.get("role") or "assistant"
                content = payload.get("content")
                content_text = extract_text_content(content)
                native_msg = payload.get("id") or record.get("id")
                parent_msg = payload.get("parent_id") or record.get("parent_id")
                model = payload.get("model")
                if model:
                    models_seen.add(model)
                if role == "user":
                    db_role = "user"
                    user_count += 1
                    if content_text and first_prompt is None:
                        first_prompt = content_text[:500]
                    if content_text:
                        domain_signals.append(content_text)
                elif role == "assistant":
                    db_role = "assistant"
                    assistant_count += 1
                    if content_text:
                        domain_signals.append(content_text)
                elif role == "system":
                    db_role = "system"
                else:
                    db_role = "system"
                _insert_message(
                    conn,
                    session_id=session_id,
                    uuid=qualify_id("codex", native_msg),
                    native_id=str(native_msg) if native_msg else None,
                    parent_uuid=qualify_id("codex", parent_msg),
                    timestamp=_ts_or_now(timestamp),
                    role=db_role,
                    message_type="message",
                    content_text=content_text,
                    content_json=json.dumps(content) if content is not None else None,
                    raw_json=json.dumps(record),
                    sequence_num=seq_num,
                    source_path=source_path,
                    model=model,
                )
                stats["messages"] += 1

            elif item_type in ("function_call", "custom_tool_call"):
                native_call = payload.get("call_id") or payload.get("id")
                name = payload.get("name") or payload.get("tool_name") or ""
                parsed_input = _parse_tool_arguments(payload.get("arguments") if item_type == "function_call" else payload.get("input"))
                file_path, command, pattern, description = _denormalize_tool_fields(parsed_input)
                assistant_count += 1
                msg_id = _insert_message(
                    conn,
                    session_id=session_id,
                    uuid=qualify_id("codex", native_call),
                    native_id=str(native_call) if native_call else None,
                    parent_uuid=None,
                    timestamp=_ts_or_now(timestamp),
                    role="assistant",
                    message_type=item_type,
                    content_text=None,
                    content_json=json.dumps(payload) if payload else None,
                    raw_json=json.dumps(record),
                    sequence_num=seq_num,
                    source_path=source_path,
                    model=payload.get("model"),
                )
                stats["messages"] += 1
                tool_count += 1
                tu_id = _insert_tool_use(
                    conn,
                    message_id=msg_id,
                    session_id=session_id,
                    tool_use_id=qualify_id("codex", native_call) or "",
                    native_id=str(native_call) if native_call else None,
                    tool_name=name,
                    input_obj=parsed_input,
                    timestamp=_ts_or_now(timestamp),
                    file_path=file_path,
                    command=command,
                    pattern=pattern,
                    description=description,
                )
                remember_tool(native_call, tu_id)
                stats["tool_uses"] += 1
                _track_file_op(file_ops_tracker, name, file_path, timestamp)

            elif item_type in ("function_call_output", "custom_tool_call_output"):
                native_call = payload.get("call_id") or payload.get("id")
                output = payload.get("output")
                if isinstance(output, str):
                    output_text = output
                elif output is None:
                    output_text = None
                else:
                    output_text = json.dumps(output)
                is_error = False
                if isinstance(payload.get("is_error"), bool):
                    is_error = payload["is_error"]
                msg_id = _insert_message(
                    conn,
                    session_id=session_id,
                    uuid=qualify_id("codex", native_call),
                    native_id=str(native_call) if native_call else None,
                    parent_uuid=None,
                    timestamp=_ts_or_now(timestamp),
                    role="tool_result",
                    message_type=item_type,
                    content_text=(output_text if output_text else None),
                    content_json=json.dumps(payload) if payload else None,
                    raw_json=json.dumps(record),
                    sequence_num=seq_num,
                    source_path=source_path,
                )
                stats["messages"] += 1
                tu_row = None
                if native_call is not None:
                    tu_row = pending_tool_uses.get(str(native_call)) or pending_tool_uses.get(
                        qualify_id("codex", native_call)
                    )
                if tu_row is not None:
                    conn.execute(
                        "UPDATE tool_uses SET result_message_id = ?, result_text = ?, is_error = ? WHERE id = ?",
                        (
                            msg_id,
                            (output_text if output_text else None),
                            1 if is_error else 0,
                            tu_row,
                        ),
                    )

            # Other response_item types stay in the source file only.

        elif rtype == "event_msg":
            etype = payload.get("type")
            if etype == "token_count":
                info = payload.get("info") if isinstance(payload.get("info"), dict) else payload
                total_usage = info.get("total_token_usage") if isinstance(info, dict) else None
                if isinstance(total_usage, dict):
                    if isinstance(total_usage.get("input_tokens"), int):
                        total_input = total_usage["input_tokens"]
                    if isinstance(total_usage.get("output_tokens"), int):
                        total_output = total_usage["output_tokens"]
                    if isinstance(total_usage.get("cached_input_tokens"), int):
                        total_cache_read = total_usage["cached_input_tokens"]
                    if isinstance(total_usage.get("cache_creation_input_tokens"), int):
                        total_cache_create = total_usage["cache_creation_input_tokens"]
                else:
                    if isinstance(payload.get("input_tokens"), int):
                        total_input = payload["input_tokens"]
                    if isinstance(payload.get("output_tokens"), int):
                        total_output = payload["output_tokens"]
                continue

            if etype in ("agent_message_delta", "user_message"):
                continue
            if etype == "agent_message":
                text = payload.get("message") or payload.get("text")
                if text in response_texts:
                    continue
                if not text:
                    continue
                assistant_count += 1
                _insert_message(
                    conn,
                    session_id=session_id,
                    uuid=None,
                    native_id=None,
                    parent_uuid=None,
                    timestamp=_ts_or_now(timestamp),
                    role="assistant",
                    message_type="event_msg",
                    content_text=str(text),
                    content_json=json.dumps(payload) if payload else None,
                    raw_json=json.dumps(record),
                    sequence_num=seq_num,
                    source_path=source_path,
                )
                stats["messages"] += 1
                domain_signals.append(str(text))

    _insert_file_ops(conn, session_id, file_ops_tracker, stats)
    primary_domain, domains_str = _classify_session_domain(domain_signals, file_ops_tracker)
    primary_model = _primary_model(models_seen)
    total_cost = 0.0
    if primary_model:
        total_cost = estimate_cost(
            primary_model,
            total_input,
            total_output,
            total_cache_create,
            total_cache_read,
        )
    _finalize_session_row(
        conn,
        session_id,
        first_ts=first_ts,
        last_ts=last_ts,
        primary_domain=primary_domain,
        domains_str=domains_str,
        summary=None,
        primary_model=primary_model,
        models_seen=models_seen,
        version=version,
        total_input=total_input,
        total_output=total_output,
        total_cache_create=total_cache_create,
        total_cache_read=total_cache_read,
        total_cost=total_cost,
        stats=stats,
        user_count=user_count,
        assistant_count=assistant_count,
        tool_count=tool_count,
        file_ops_tracker=file_ops_tracker,
        compact_count=0,
        subagent_count=0,
        first_prompt=first_prompt,
        line_count=len(lines),
    )
    _write_complete_harvest_log(
        conn, jsonl_path, fhash, fsize, fmtime, session_uuid, "codex", len(lines), stats["messages"]
    )


def build_concurrency_groups(conn: sqlite3.Connection):
    """Cluster overlapping sessions into concurrency groups."""
    conn.execute("DELETE FROM concurrency_groups")
    conn.execute("UPDATE sessions SET concurrency_group_id = NULL")

    sessions = conn.execute(
        "SELECT id, session_uuid, started_at, ended_at, primary_domain FROM sessions WHERE started_at IS NOT NULL AND started_at != '' ORDER BY started_at"
    ).fetchall()

    if not sessions:
        return

    groups = []  # list of (group_id, [session_ids], start, end, domains)
    current_group = None

    for s in sessions:
        s_start = s["started_at"]
        s_end = s["ended_at"] or s["started_at"]

        if current_group is None:
            current_group = {
                "sessions": [s["id"]],
                "start": s_start,
                "end": s_end,
                "domains": {s["primary_domain"]} if s["primary_domain"] else set(),
            }
        elif s_start <= current_group["end"]:
            # Overlaps with current group
            current_group["sessions"].append(s["id"])
            if s_end > current_group["end"]:
                current_group["end"] = s_end
            if s["primary_domain"]:
                current_group["domains"].add(s["primary_domain"])
        else:
            # No overlap — finalize current group and start new
            if len(current_group["sessions"]) > 1:
                groups.append(current_group)
            current_group = {
                "sessions": [s["id"]],
                "start": s_start,
                "end": s_end,
                "domains": {s["primary_domain"]} if s["primary_domain"] else set(),
            }

    if current_group and len(current_group["sessions"]) > 1:
        groups.append(current_group)

    for grp in groups:
        conn.execute(
            "INSERT INTO concurrency_groups (started_at, ended_at, session_count, domains) VALUES (?, ?, ?, ?)",
            (grp["start"], grp["end"], len(grp["sessions"]),
             ",".join(sorted(grp["domains"])) if grp["domains"] else None)
        )
        group_id = conn.execute("SELECT last_insert_rowid()").fetchone()[0]
        for sid in grp["sessions"]:
            conn.execute(
                "UPDATE sessions SET concurrency_group_id = ? WHERE id = ?",
                (group_id, sid)
            )


def harvest_vault_files(conn: sqlite3.Connection, vault_root: Path,
                        dry_run: bool = False, force: bool = False,
                        since: str = None) -> dict:
    """Index all markdown files in the Obsidian vault into FTS5.

    Walks the vault, reads each .md file, extracts frontmatter and title,
    classifies domain from path, and inserts into vault_files + fts_unified.
    Incremental by default — skips files whose SHA-256 hash hasn't changed.
    """
    stats = {"indexed": 0, "skipped": 0, "updated": 0, "errors": 0}

    # Exclusion patterns
    exclude_dirs = {
        "node_modules", ".obsidian", "99 - Archive", ".trash",
        ".git", ".claude", "Xnapper",
    }

    # Collect all .md files
    md_files = []
    for root, dirs, files in os.walk(vault_root):
        # Prune excluded directories
        dirs[:] = [d for d in dirs if d not in exclude_dirs]
        for fname in files:
            if fname.endswith(".md"):
                md_files.append(Path(root) / fname)

    # Filter by since date if provided
    if since:
        cutoff_ts = datetime.strptime(since, "%Y-%m-%d").timestamp()
        md_files = [f for f in md_files if f.stat().st_mtime >= cutoff_ts]

    total = len(md_files)
    print(f"  Vault: {total} markdown files to process")

    for i, md_path in enumerate(md_files, 1):
        try:
            fsize = md_path.stat().st_size
            fmtime = datetime.fromtimestamp(
                md_path.stat().st_mtime, tz=timezone.utc
            ).isoformat()

            # Skip very large files (>500KB — likely generated/data)
            if fsize > 512_000:
                stats["skipped"] += 1
                continue

            # Read content
            try:
                content = md_path.read_text(encoding="utf-8", errors="replace")
            except OSError:
                stats["errors"] += 1
                continue

            # Hash for change detection
            fhash = hashlib.sha256(content.encode()).hexdigest()

            # Check if already indexed with same hash
            if not force:
                existing = conn.execute(
                    "SELECT file_hash FROM vault_files WHERE file_path = ?",
                    (str(md_path),)
                ).fetchone()
                if existing and existing[0] == fhash:
                    stats["skipped"] += 1
                    continue

            if dry_run:
                stats["skipped"] += 1
                continue

            # Extract vault-relative path
            vrel = str(md_path).replace(str(vault_root) + "/", "")

            # Classify domain from path
            domain = classify_domain_from_path(str(md_path))

            # Extract title (first # heading or filename)
            title = md_path.stem
            for line in content.split("\n")[:20]:
                if line.startswith("# ") and not line.startswith("# ---"):
                    title = line[2:].strip()
                    break

            # Extract frontmatter (everything between first --- and second ---)
            frontmatter = None
            if content.startswith("---"):
                end = content.find("---", 3)
                if end > 0:
                    frontmatter = content[3:end].strip()
            # Also handle field:: value style (no --- delimiters)
            elif content and "::" in content.split("\n")[0]:
                fm_lines = []
                for line in content.split("\n"):
                    if "::" in line:
                        fm_lines.append(line)
                    elif line.strip() == "" and fm_lines:
                        break
                    elif line.startswith("#"):
                        break
                    else:
                        break
                if fm_lines:
                    frontmatter = "\n".join(fm_lines)

            # Word count
            words = len(content.split())

            # File creation time
            try:
                created_at = datetime.fromtimestamp(
                    md_path.stat().st_birthtime, tz=timezone.utc
                ).isoformat()
            except (AttributeError, OSError):
                created_at = fmtime

            # Upsert into vault_files
            # Need to handle the FTS triggers properly for updates
            existing_row = conn.execute(
                "SELECT id FROM vault_files WHERE file_path = ?",
                (str(md_path),)
            ).fetchone()

            if existing_row:
                # Update existing — triggers handle FTS sync
                conn.execute(
                    """UPDATE vault_files SET
                        vault_relative = ?, domain = ?, title = ?,
                        frontmatter = ?, content_text = ?,
                        char_count = ?, word_count = ?,
                        file_hash = ?, file_mtime = ?, file_size = ?,
                        harvested_at = ?, harvest_version = ?
                       WHERE file_path = ?""",
                    (vrel, domain, title, frontmatter, content,
                     len(content), words, fhash, fmtime, fsize,
                     datetime.now(timezone.utc).isoformat(), SCHEMA_VERSION,
                     str(md_path))
                )
                stats["updated"] += 1
            else:
                # Insert new
                conn.execute(
                    """INSERT INTO vault_files
                       (file_path, vault_relative, domain, title,
                        frontmatter, content_text, char_count, word_count,
                        file_hash, file_mtime, file_size, created_at,
                        harvested_at, harvest_version)
                       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
                    (str(md_path), vrel, domain, title,
                     frontmatter, content, len(content), words,
                     fhash, fmtime, fsize, created_at,
                     datetime.now(timezone.utc).isoformat(), SCHEMA_VERSION)
                )
                stats["indexed"] += 1

            # Commit in batches
            if i % 100 == 0:
                conn.commit()
                pct = int(i / total * 100)
                sys.stdout.write(f"\r  [{pct:3d}%] {i}/{total} — {stats['indexed']} new, {stats['updated']} updated, {stats['skipped']} unchanged")
                sys.stdout.flush()

        except Exception as e:
            stats["errors"] += 1
            if stats["errors"] <= 5:
                print(f"\n  ERROR: {md_path.name}: {e}")

    conn.commit()
    print(f"\r  [100%] {total}/{total} — {stats['indexed']} new, {stats['updated']} updated, {stats['skipped']} unchanged")

    return stats


def _empty_receipt() -> dict:
    return {
        "roots": [],
        "discovered": 0,
        "harvested": 0,
        "skipped": 0,
        "errors": 0,
        "unknown_formats": 0,
        "conflicts": 0,
        "messages": 0,
        "tool_uses": 0,
        "notes": [],
    }


def print_harvest_receipt(receipt: dict):
    print("\nHarvest receipt")
    print("  Configured roots:")
    if not receipt["roots"]:
        print("    (none)")
    for root in receipt["roots"]:
        if root["available"]:
            state = "available"
        else:
            reason = root.get("reason") or "unavailable"
            state = f"unavailable ({reason})"
        print(f"    {root['name']}: {root['path']} — {state}")
    print(f"  Discovered: {receipt['discovered']}")
    print(f"  Harvested:  {receipt['harvested']}")
    print(f"  Skipped:    {receipt['skipped']}")
    print(f"  Errors:     {receipt['errors']}")
    print(f"  Unknown formats: {receipt['unknown_formats']}")
    print(f"  Conflicts:  {receipt['conflicts']}")
    unavailable = [r for r in receipt["roots"] if not r["available"]]
    if unavailable:
        print("  Note: unavailable roots mean coverage is unknown.")
    if receipt["discovered"] == 0:
        print("  Note: 0 discovered files is not evidence of complete coverage.")
    for note in receipt.get("notes", []):
        print(f"  Note: {note}")


def _filter_since(paths: list, since: "str | None") -> list:
    if not since:
        return paths
    cutoff = datetime.strptime(since, "%Y-%m-%d").replace(tzinfo=timezone.utc)
    kept = []
    for path in paths:
        try:
            mtime = datetime.fromtimestamp(path.stat().st_mtime, tz=timezone.utc)
        except OSError:
            continue
        if mtime >= cutoff:
            kept.append(path)
    return kept


def _session_filename_match(path: Path, session_id: str) -> bool:
    needle = session_id.removeprefix("codex:")
    records, errors = load_jsonl_records(path)
    if errors:
        return False
    native = extract_codex_session_id(records)
    ids = {str(r["sessionId"]) for r in records if r.get("sessionId")}
    if native:
        ids.add(native)
    if not ids:
        ids.add(path.stem)
    return needle in ids


def _harvest_paths(
    conn: sqlite3.Connection,
    files: list,
    receipt: dict,
    *,
    dry_run: bool,
    force: bool,
    expected_provider: str,
    project_lookup: dict,
):
    total = len(files)
    for i, jf in enumerate(files, 1):
        receipt["discovered"] += 1
        project_path = project_lookup.get(str(jf))
        try:
            result = harvest_jsonl(
                conn,
                jf,
                dry_run=dry_run,
                force=force,
                project_path=project_path,
                expected_provider=expected_provider,
            )
            status = result.get("status")
            if result.get("skipped"):
                receipt["skipped"] += 1
            elif result.get("conflict") or status == "conflict":
                receipt["conflicts"] += 1
                conn.rollback()
                if not dry_run:
                    _write_error_harvest_log(
                        conn,
                        jf,
                        "conflicting duplicate identity",
                        result.get("session_uuid"),
                        result.get("provider") or expected_provider,
                    )
                    conn.commit()
            elif result.get("unknown_format") or status == "unknown_format":
                receipt["unknown_formats"] += 1
                conn.rollback()
                if not dry_run:
                    _write_error_harvest_log(
                        conn,
                        jf,
                        "unknown transcript format",
                        result.get("session_uuid"),
                        expected_provider,
                    )
                    conn.commit()
            elif status == "error":
                receipt["errors"] += 1
                conn.rollback()
                if not dry_run:
                    _write_error_harvest_log(
                        conn,
                        jf,
                        "malformed input",
                        result.get("session_uuid"),
                        expected_provider,
                    )
                    conn.commit()
            else:
                receipt["harvested"] += 1
                receipt["messages"] += result.get("messages", 0)
                receipt["tool_uses"] += result.get("tool_uses", 0)
                receipt["errors"] += result.get("errors", 0)
                conn.commit()
        except Exception as exc:
            receipt["errors"] += 1
            print(f"\n  ERROR: {jf.name}: {exc}")
            conn.rollback()
            if not dry_run:
                _write_error_harvest_log(conn, jf, str(exc), provider=expected_provider)
                conn.commit()

        if total and (i % 10 == 0 or i == total):
            pct = int(i / total * 100)
            sys.stdout.write(
                f"\r  [{pct:3d}%] {i}/{total} — {receipt['harvested']} harvested, {receipt['skipped']} skipped"
            )
            sys.stdout.flush()
    if total:
        print()


def cmd_harvest(args):
    """Ingest JSONL transcripts and vault files into the database."""
    if args.dry_run:
        conn = sqlite3.connect(":memory:")
        conn.row_factory = sqlite3.Row
    else:
        conn = get_db()
    ensure_schema(conn)

    source = args.source
    receipt = _empty_receipt()

    if source in ("claude-code", "all"):
        project_dirs, claude_root = discover_claude_project_dirs()
        receipt["roots"].append(claude_root)
        discovered = discover_claude_session_files(project_dirs)
        if args.session:
            discovered = [
                item for item in discovered if _session_filename_match(item["path"], args.session)
            ]
        jsonl_files = [item["path"] for item in discovered]
        jsonl_files = _filter_since(jsonl_files, args.since)
        project_lookup = {str(item["path"]): item["project_path"] for item in discovered}
        print(f"[claude-code] {len(jsonl_files)} JSONL file(s)")
        _harvest_paths(
            conn,
            jsonl_files,
            receipt,
            dry_run=args.dry_run,
            force=args.full,
            expected_provider="claude-code",
            project_lookup=project_lookup,
        )

    if source in ("codex", "all"):
        codex_files, codex_root = discover_codex_jsonl(get_codex_dir())
        receipt["roots"].append(codex_root)
        receipt["roots"].extend(codex_root.get("children", []))
        if args.session:
            codex_files = [path for path in codex_files if _session_filename_match(path, args.session)]
        codex_files = _filter_since(codex_files, args.since)
        print(f"[codex] {len(codex_files)} JSONL file(s)")
        _harvest_paths(
            conn,
            codex_files,
            receipt,
            dry_run=args.dry_run,
            force=args.full,
            expected_provider="codex",
            project_lookup={},
        )

    if source in ("vault", "all"):
        vault_root = get_vault_root()
        if vault_root is None:
            receipt["roots"].append(
                _root_status("vault", Path("LEDGER_VAULT"), False, "not configured")
            )
            print("[vault] LEDGER_VAULT is not set — vault harvest skipped")
            receipt["notes"].append("Set LEDGER_VAULT to index markdown files.")
        elif not _path_exists(vault_root):
            receipt["roots"].append(_root_status("vault", vault_root, False, "missing"))
            print(f"[vault] root unavailable: {vault_root}")
        elif not _path_is_dir(vault_root):
            receipt["roots"].append(_root_status("vault", vault_root, False, "not a directory"))
            print(f"[vault] root unavailable: {vault_root}")
        else:
            receipt["roots"].append(_root_status("vault", vault_root, True))
            print("[vault] Indexing markdown files...")
            vault_stats = harvest_vault_files(
                conn,
                vault_root,
                dry_run=args.dry_run,
                force=args.full,
                since=args.since,
            )
            print(
                f"  Vault: {vault_stats['indexed']} new, {vault_stats['updated']} updated, "
                f"{vault_stats['skipped']} unchanged, {vault_stats['errors']} errors"
            )
            receipt["errors"] += vault_stats["errors"]

    if receipt["harvested"] > 0 and not args.dry_run:
        print("  Building concurrency groups...")
        build_concurrency_groups(conn)
        conn.commit()

    print(
        f"  Transcripts: {receipt['harvested']} harvested, {receipt['skipped']} unchanged, "
        f"{receipt['errors']} errors"
    )
    print(f"  Messages: {receipt['messages']:,} | Tool uses: {receipt['tool_uses']:,}")
    print_harvest_receipt(receipt)

    db_size = DB_PATH.stat().st_size if DB_PATH.exists() else 0
    vault_count = conn.execute("SELECT COUNT(*) FROM vault_files").fetchone()[0]
    session_count = conn.execute("SELECT COUNT(*) FROM sessions").fetchone()[0]
    msg_count = conn.execute("SELECT COUNT(*) FROM messages").fetchone()[0]
    print(
        f"\n  DB: {db_size / 1024 / 1024:.1f} MB | {session_count} sessions | "
        f"{msg_count:,} messages | {vault_count:,} vault files"
    )
    conn.close()
    return 1 if receipt["errors"] or receipt["conflicts"] or receipt["unknown_formats"] else 0


