def harvest_jsonl(conn: sqlite3.Connection, jsonl_path: Path,
                  dry_run: bool = False, force: bool = False) -> dict:
    """Harvest a single JSONL transcript into the database.

    Returns dict with counts: messages, tool_uses, files, errors.
    """
    stats = {"messages": 0, "tool_uses": 0, "file_ops": 0, "errors": 0, "skipped": False}

    # Check harvest log
    fhash = file_sha256(jsonl_path)
    fsize = jsonl_path.stat().st_size
    fmtime = datetime.fromtimestamp(jsonl_path.stat().st_mtime, tz=timezone.utc).isoformat()

    if not force:
        existing = conn.execute(
            "SELECT id FROM harvest_log WHERE file_path = ? AND file_hash = ?",
            (str(jsonl_path), fhash)
        ).fetchone()
        if existing:
            stats["skipped"] = True
            return stats

    if dry_run:
        stats["skipped"] = True
        return stats

    # Extract session UUID from filename
    stem = jsonl_path.stem
    session_uuid = stem  # UUID is the filename

    # Read all lines
    lines = []
    with open(jsonl_path, "r", encoding="utf-8") as f:
        for line in f:
            stripped = line.strip()
            if stripped:
                try:
                    lines.append(json.loads(stripped))
                except json.JSONDecodeError:
                    stats["errors"] += 1

    if not lines:
        return stats

    # Extract session metadata
    first_ts = None
    last_ts = None
    models_seen = set()
    version = None
    first_prompt = None
    domain_signals = []
    total_input = 0
    total_output = 0
    total_cache_create = 0
    total_cache_read = 0
    user_count = 0
    assistant_count = 0
    tool_count = 0
    compact_count = 0

    # Pending tool_use → tool_result linkage
    pending_tool_uses = {}  # tool_use_id → tool_uses.id

    # Create or update session row
    # Check if session already exists (re-harvest)
    existing_session = conn.execute(
        "SELECT id FROM sessions WHERE session_uuid = ? AND source = 'claude-code'",
        (session_uuid,)
    ).fetchone()

    if existing_session:
        session_id = existing_session["id"]
        # Clear old data for re-harvest
        conn.execute("DELETE FROM messages WHERE session_id = ?", (session_id,))
        conn.execute("DELETE FROM tool_uses WHERE session_id = ?", (session_id,))
        conn.execute("DELETE FROM file_operations WHERE session_id = ?", (session_id,))
        conn.execute("DELETE FROM compactions WHERE session_id = ?", (session_id,))
    else:
        # Insert placeholder session row
        conn.execute(
            """INSERT INTO sessions (session_uuid, source, project_path, jsonl_path, started_at,
               is_harvested, harvest_version, harvested_at, raw_line_count)
               VALUES (?, 'claude-code', ?, ?, ?, 0, ?, ?, ?)""",
            (session_uuid, str(PROJECTS_DIR), str(jsonl_path),
             datetime.now(timezone.utc).isoformat(),
             SCHEMA_VERSION, datetime.now(timezone.utc).isoformat(), len(lines))
        )
        session_id = conn.execute("SELECT last_insert_rowid()").fetchone()[0]

    # Process each JSONL line
    file_ops_tracker = {}  # (file_path, operation) → {first_at, last_at, count}

    for seq_num, record in enumerate(lines):
        if not isinstance(record, dict):
            continue
        rtype = record.get("type")
        timestamp = parse_timestamp(record.get("timestamp"))

        if timestamp:
            if first_ts is None or timestamp < first_ts:
                first_ts = timestamp
            if last_ts is None or timestamp > last_ts:
                last_ts = timestamp

        if rtype == "user":
            msg = record.get("message", {})
            content = msg.get("content")
            content_text = extract_text_content(content)
            is_sidechain = 1 if record.get("isSidechain") else 0

            if record.get("version"):
                version = record["version"]

            # Check if this is a tool result
            tool_results = extract_tool_results(content) if isinstance(content, list) else []

            if tool_results:
                # This is a tool result message
                for tr in tool_results:
                    conn.execute(
                        """INSERT INTO messages (session_id, uuid, parent_uuid, timestamp,
                           role, message_type, content_text, content_json, raw_json,
                           is_sidechain, sequence_num)
                           VALUES (?, ?, ?, ?, 'tool_result', 'user', ?, ?, ?, ?, ?)""",
                        (session_id, record.get("uuid"), record.get("parentUuid"),
                         timestamp or datetime.now(timezone.utc).isoformat(),
                         tr["content"][:5000], json.dumps(content) if content else None,
                         json.dumps(record),
                         is_sidechain, seq_num)
                    )
                    msg_id = conn.execute("SELECT last_insert_rowid()").fetchone()[0]
                    stats["messages"] += 1

                    # Link tool result back to tool_use
                    tuid = tr["tool_use_id"]
                    if tuid in pending_tool_uses:
                        conn.execute(
                            "UPDATE tool_uses SET result_message_id = ?, result_text = ?, is_error = ? WHERE id = ?",
                            (msg_id, tr["content"][:10000],
                             1 if tr["is_error"] else 0,
                             pending_tool_uses[tuid])
                        )
                        del pending_tool_uses[tuid]
            else:
                # Real user message
                if not record.get("isMeta") and content_text and first_prompt is None:
                    first_prompt = content_text[:500]
                    domain_signals.append(content_text)

                if not record.get("isMeta") and content_text:
                    user_count += 1
                    domain_signals.append(content_text)

                conn.execute(
                    """INSERT INTO messages (session_id, uuid, parent_uuid, timestamp,
                       role, message_type, content_text, content_json, raw_json,
                       is_sidechain, sequence_num)
                       VALUES (?, ?, ?, ?, 'user', 'user', ?, ?, ?, ?, ?)""",
                    (session_id, record.get("uuid"), record.get("parentUuid"),
                     timestamp or datetime.now(timezone.utc).isoformat(),
                     content_text,
                     json.dumps(content) if isinstance(content, list) else None,
                     json.dumps(record),
                     is_sidechain, seq_num)
                )
                stats["messages"] += 1

        elif rtype == "assistant":
            msg = record.get("message", {})
            content = msg.get("content", [])
            content_text = extract_text_content(content)
            model = msg.get("model")
            usage = msg.get("usage", {})

            if model and model != "<synthetic>":
                models_seen.add(model)

            # Token accounting
            in_tok = usage.get("input_tokens", 0) or 0
            out_tok = usage.get("output_tokens", 0) or 0
            cc_tok = usage.get("cache_creation_input_tokens", 0) or 0
            cr_tok = usage.get("cache_read_input_tokens", 0) or 0
            total_input += in_tok
            total_output += out_tok
            total_cache_create += cc_tok
            total_cache_read += cr_tok

            assistant_count += 1

            conn.execute(
                """INSERT INTO messages (session_id, uuid, parent_uuid, timestamp,
                   role, message_type, content_text, content_json, raw_json,
                   model, request_id, stop_reason,
                   input_tokens, output_tokens, cache_create_tokens, cache_read_tokens,
                   is_sidechain, sequence_num)
                   VALUES (?, ?, ?, ?, 'assistant', 'assistant', ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
                (session_id, record.get("uuid"), record.get("parentUuid"),
                 timestamp or datetime.now(timezone.utc).isoformat(),
                 content_text,
                 json.dumps(content) if isinstance(content, list) else None,
                 json.dumps(record),
                 model, msg.get("id"), msg.get("stop_reason"),
                 in_tok, out_tok, cc_tok, cr_tok,
                 1 if record.get("isSidechain") else 0, seq_num)
            )
            msg_id = conn.execute("SELECT last_insert_rowid()").fetchone()[0]
            stats["messages"] += 1

            if content_text:
                domain_signals.append(content_text)

            # Extract tool uses
            tool_uses = extract_tool_uses_from_content(content)
            for tu in tool_uses:
                tool_count += 1
                conn.execute(
                    """INSERT INTO tool_uses (message_id, session_id, tool_use_id, tool_name,
                       input_json, timestamp, file_path, command, pattern, description)
                       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
                    (msg_id, session_id, tu["tool_use_id"], tu["tool_name"],
                     json.dumps(tu["input"]),
                     timestamp or datetime.now(timezone.utc).isoformat(),
                     tu.get("file_path"), tu.get("command"),
                     tu.get("pattern"), tu.get("description"))
                )
                tu_id = conn.execute("SELECT last_insert_rowid()").fetchone()[0]
                pending_tool_uses[tu["tool_use_id"]] = tu_id
                stats["tool_uses"] += 1

                # Track file operations
                fp = tu.get("file_path")
                if fp:
                    op_name = tu["tool_name"].lower()
                    if op_name in ("read", "write", "edit", "glob", "grep"):
                        key = (fp, op_name)
                        ts_str = timestamp or datetime.now(timezone.utc).isoformat()
                        if key in file_ops_tracker:
                            file_ops_tracker[key]["last_at"] = ts_str
                            file_ops_tracker[key]["count"] += 1
                        else:
                            file_ops_tracker[key] = {
                                "first_at": ts_str,
                                "last_at": ts_str,
                                "count": 1,
                            }

        elif rtype == "system":
            subtype = record.get("subtype")
            content_text = None

            if subtype == "compact_boundary":
                compact_count += 1
                summary_content = record.get("summary")
                if isinstance(summary_content, list):
                    summary_content = extract_text_content(summary_content)
                elif isinstance(summary_content, str):
                    pass
                else:
                    summary_content = None

                conn.execute(
                    """INSERT INTO messages (session_id, uuid, parent_uuid, timestamp,
                       role, message_type, subtype, content_text, raw_json,
                       is_compact_summary, sequence_num)
                       VALUES (?, ?, ?, ?, 'system', 'system', ?, ?, ?, 1, ?)""",
                    (session_id, record.get("uuid"), record.get("parentUuid"),
                     timestamp or datetime.now(timezone.utc).isoformat(),
                     subtype, summary_content, json.dumps(record), seq_num)
                )

                if summary_content:
                    msg_id = conn.execute("SELECT last_insert_rowid()").fetchone()[0]
                    conn.execute(
                        "INSERT INTO compactions (session_id, message_id, pre_tokens, summary_text, timestamp) VALUES (?, ?, ?, ?, ?)",
                        (session_id, msg_id, record.get("preTokens"),
                         summary_content, timestamp or datetime.now(timezone.utc).isoformat())
                    )
            else:
                conn.execute(
                    """INSERT INTO messages (session_id, uuid, parent_uuid, timestamp,
                       role, message_type, subtype, content_text, raw_json, sequence_num)
                       VALUES (?, ?, ?, ?, 'system', 'system', ?, ?, ?, ?)""",
                    (session_id, record.get("uuid"), record.get("parentUuid"),
                     timestamp or datetime.now(timezone.utc).isoformat(),
                     subtype, str(record.get("content", ""))[:1000],
                     json.dumps(record), seq_num)
                )
            stats["messages"] += 1

        # Skip progress, file-history-snapshot, queue-operation, last-prompt
        # They're captured in raw_json of adjacent messages

    # Insert file operations
    for (fp, op), tracker in file_ops_tracker.items():
        vrel = vault_relative_path(fp)
        domain = classify_domain_from_path(fp)
        try:
            conn.execute(
                """INSERT OR REPLACE INTO file_operations
                   (session_id, file_path, operation, first_at, last_at, operation_count, vault_relative, domain)
                   VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
                (session_id, fp, op, tracker["first_at"], tracker["last_at"],
                 tracker["count"], vrel, domain)
            )
            stats["file_ops"] += 1
        except sqlite3.Error:
            stats["errors"] += 1

    # Classify domain
    all_text = " ".join(domain_signals[:20])  # first 20 signals
    text_domain = classify_domain_from_text(all_text)

    # Also check file operations for domain signals
    path_domains = {}
    for (fp, _) in file_ops_tracker:
        d = classify_domain_from_path(fp)
        if d:
            path_domains[d] = path_domains.get(d, 0) + 1

    primary_domain = text_domain
    if path_domains:
        path_winner = max(path_domains, key=path_domains.get)
        if not primary_domain or path_domains[path_winner] > 3:
            primary_domain = path_winner

    all_domains = set()
    if text_domain:
        all_domains.add(text_domain)
    all_domains.update(path_domains.keys())
    domains_str = ",".join(sorted(all_domains)) if all_domains else None

    # Compute duration
    duration_ms = None
    if first_ts and last_ts:
        try:
            dt_first = datetime.fromisoformat(first_ts)
            dt_last = datetime.fromisoformat(last_ts)
            duration_ms = int((dt_last - dt_first).total_seconds() * 1000)
        except (ValueError, TypeError):
            pass

    # Determine primary model
    primary_model = None
    if models_seen:
        # Prefer opus > sonnet > haiku
        for m in ["claude-opus-4-6", "claude-sonnet-4-5-20250929", "claude-haiku-4-5-20251001"]:
            if m in models_seen:
                primary_model = m
                break
        if not primary_model:
            primary_model = next(iter(models_seen))

    # Compute cost
    total_cost = 0.0
    if primary_model:
        total_cost = estimate_cost(
            primary_model, total_input, total_output,
            total_cache_create, total_cache_read
        )

    # Load summary from sessions-index.json if available
    summary = None
    if SESSIONS_INDEX.exists():
        try:
            idx_raw = json.loads(SESSIONS_INDEX.read_text())
            # sessions-index.json is a dict with {"version": 1, "entries": [...]}
            entries = []
            if isinstance(idx_raw, dict):
                entries = idx_raw.get("entries", [])
            elif isinstance(idx_raw, list):
                entries = idx_raw
            for entry in entries:
                if not isinstance(entry, dict):
                    continue
                if entry.get("sessionId") == session_uuid:
                    summary = entry.get("summary")
                    if not first_prompt and entry.get("firstPrompt"):
                        first_prompt = entry["firstPrompt"]
                    break
        except (json.JSONDecodeError, OSError):
            pass

    # Load enrichment from usage-data if available
    meta_file = USAGE_META_DIR / f"{session_uuid}.json"
    if meta_file.exists():
        try:
            meta = json.loads(meta_file.read_text())
            if not summary and meta.get("summary"):
                summary = meta["summary"]
            if not first_prompt and meta.get("first_prompt"):
                first_prompt = meta["first_prompt"]
        except (json.JSONDecodeError, OSError):
            pass

    # Count subagents
    subagent_dir = PROJECTS_DIR / session_uuid / "subagents"
    subagent_count = 0
    if subagent_dir.is_dir():
        subagent_files = list(subagent_dir.glob("agent-*.jsonl"))
        subagent_count = len(subagent_files)
        for sa_file in subagent_files:
            agent_id_match = re.match(r"agent-(.+)\.jsonl", sa_file.name)
            agent_id = agent_id_match.group(1) if agent_id_match else sa_file.stem
            try:
                sa_lines = []
                with open(sa_file) as f:
                    for line in f:
                        s = line.strip()
                        if s:
                            try:
                                sa_lines.append(json.loads(s))
                            except json.JSONDecodeError:
                                pass

                sa_slug = None
                sa_model = None
                sa_in = 0
                sa_out = 0
                sa_msgs = 0
                sa_tools = 0
                sa_first_ts = None
                sa_last_ts = None

                for sar in sa_lines:
                    if sar.get("slug"):
                        sa_slug = sar["slug"]
                    ts = parse_timestamp(sar.get("timestamp"))
                    if ts:
                        if sa_first_ts is None or ts < sa_first_ts:
                            sa_first_ts = ts
                        if sa_last_ts is None or ts > sa_last_ts:
                            sa_last_ts = ts
                    if sar.get("type") in ("user", "assistant"):
                        sa_msgs += 1
                    if sar.get("type") == "assistant":
                        msg = sar.get("message", {})
                        if msg.get("model"):
                            sa_model = msg["model"]
                        usage = msg.get("usage", {})
                        sa_in += usage.get("input_tokens", 0) or 0
                        sa_out += usage.get("output_tokens", 0) or 0
                        for block in (msg.get("content") or []):
                            if isinstance(block, dict) and block.get("type") == "tool_use":
                                sa_tools += 1

                conn.execute(
                    """INSERT OR REPLACE INTO subagents
                       (session_id, agent_id, slug, model, jsonl_path,
                        message_count, tool_use_count, input_tokens, output_tokens,
                        started_at, ended_at)
                       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
                    (session_id, agent_id, sa_slug, sa_model, str(sa_file),
                     sa_msgs, sa_tools, sa_in, sa_out, sa_first_ts, sa_last_ts)
                )
            except OSError:
                pass

    # Update session row with computed data
    conn.execute(
        """UPDATE sessions SET
            started_at = ?, ended_at = ?, duration_ms = ?,
            primary_domain = ?, domains = ?, summary = ?,
            primary_model = ?, models_used = ?, claude_version = ?,
            total_input_tokens = ?, total_output_tokens = ?,
            total_cache_create = ?, total_cache_read = ?,
            estimated_cost_usd = ?,
            message_count = ?, user_message_count = ?,
            assistant_turn_count = ?, tool_use_count = ?,
            files_read_count = ?, files_written_count = ?,
            files_edited_count = ?, compact_count = ?,
            subagent_count = ?, first_prompt = ?,
            is_harvested = 1, harvested_at = ?, raw_line_count = ?
           WHERE id = ?""",
        (first_ts or datetime.now(timezone.utc).isoformat(),
         last_ts, duration_ms,
         primary_domain, domains_str, summary,
         primary_model, ",".join(sorted(models_seen)) if models_seen else None,
         version,
         total_input, total_output, total_cache_create, total_cache_read,
         total_cost,
         stats["messages"], user_count, assistant_count, tool_count,
         sum(1 for (_, op) in file_ops_tracker if op == "read"),
         sum(1 for (_, op) in file_ops_tracker if op == "write"),
         sum(1 for (_, op) in file_ops_tracker if op == "edit"),
         compact_count,
         subagent_count, first_prompt,
         datetime.now(timezone.utc).isoformat(), len(lines),
         session_id)
    )

    # Record in harvest log
    conn.execute(
        """INSERT OR REPLACE INTO harvest_log
           (file_path, file_hash, file_size, file_mtime, session_uuid,
            harvested_at, line_count, message_count, status, harvest_version)
           VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'complete', ?)""",
        (str(jsonl_path), fhash, fsize, fmtime, session_uuid,
         datetime.now(timezone.utc).isoformat(), len(lines),
         stats["messages"], SCHEMA_VERSION)
    )

    return stats


def build_concurrency_groups(conn: sqlite3.Connection):
    """Cluster overlapping sessions into concurrency groups."""
    conn.execute("DELETE FROM concurrency_groups")
    conn.execute("UPDATE sessions SET concurrency_group_id = NULL")

    sessions = conn.execute(
        "SELECT id, session_uuid, started_at, ended_at, primary_domain FROM sessions ORDER BY started_at"
    ).fetchall()

    if not sessions:
        return

    groups = []  # list of (group_id, [session_ids], start, end, domains)
    current_group = None

    for s in sessions:
        s_start = s["started_at"]
        s_end = s["ended_at"] or s["started_at"]

        if current_group is None:
            current_group = {
                "sessions": [s["id"]],
                "start": s_start,
                "end": s_end,
                "domains": {s["primary_domain"]} if s["primary_domain"] else set(),
            }
        elif s_start <= current_group["end"]:
            # Overlaps with current group
            current_group["sessions"].append(s["id"])
            if s_end > current_group["end"]:
                current_group["end"] = s_end
            if s["primary_domain"]:
                current_group["domains"].add(s["primary_domain"])
        else:
            # No overlap — finalize current group and start new
            if len(current_group["sessions"]) > 1:
                groups.append(current_group)
            current_group = {
                "sessions": [s["id"]],
                "start": s_start,
                "end": s_end,
                "domains": {s["primary_domain"]} if s["primary_domain"] else set(),
            }

    if current_group and len(current_group["sessions"]) > 1:
        groups.append(current_group)

    for grp in groups:
        conn.execute(
            "INSERT INTO concurrency_groups (started_at, ended_at, session_count, domains) VALUES (?, ?, ?, ?)",
            (grp["start"], grp["end"], len(grp["sessions"]),
             ",".join(sorted(grp["domains"])) if grp["domains"] else None)
        )
        group_id = conn.execute("SELECT last_insert_rowid()").fetchone()[0]
        for sid in grp["sessions"]:
            conn.execute(
                "UPDATE sessions SET concurrency_group_id = ? WHERE id = ?",
                (group_id, sid)
            )


def harvest_vault_files(conn: sqlite3.Connection, vault_root: Path,
                        dry_run: bool = False, force: bool = False,
                        since: str = None) -> dict:
    """Index all markdown files in the Obsidian vault into FTS5.

    Walks the vault, reads each .md file, extracts frontmatter and title,
    classifies domain from path, and inserts into vault_files + fts_unified.
    Incremental by default — skips files whose SHA-256 hash hasn't changed.
    """
    stats = {"indexed": 0, "skipped": 0, "updated": 0, "errors": 0}

    # Exclusion patterns
    exclude_dirs = {
        "node_modules", ".obsidian", "99 - Archive", ".trash",
        ".git", ".claude", "Xnapper",
    }

    # Collect all .md files
    md_files = []
    for root, dirs, files in os.walk(vault_root):
        # Prune excluded directories
        dirs[:] = [d for d in dirs if d not in exclude_dirs]
        for fname in files:
            if fname.endswith(".md"):
                md_files.append(Path(root) / fname)

    # Filter by since date if provided
    if since:
        cutoff_ts = datetime.strptime(since, "%Y-%m-%d").timestamp()
        md_files = [f for f in md_files if f.stat().st_mtime >= cutoff_ts]

    total = len(md_files)
    print(f"  Vault: {total} markdown files to process")

    for i, md_path in enumerate(md_files, 1):
        try:
            fsize = md_path.stat().st_size
            fmtime = datetime.fromtimestamp(
                md_path.stat().st_mtime, tz=timezone.utc
            ).isoformat()

            # Skip very large files (>500KB — likely generated/data)
            if fsize > 512_000:
                stats["skipped"] += 1
                continue

            # Read content
            try:
                content = md_path.read_text(encoding="utf-8", errors="replace")
            except OSError:
                stats["errors"] += 1
                continue

            # Hash for change detection
            fhash = hashlib.sha256(content.encode()).hexdigest()

            # Check if already indexed with same hash
            if not force:
                existing = conn.execute(
                    "SELECT file_hash FROM vault_files WHERE file_path = ?",
                    (str(md_path),)
                ).fetchone()
                if existing and existing[0] == fhash:
                    stats["skipped"] += 1
                    continue

            if dry_run:
                stats["skipped"] += 1
                continue

            # Extract vault-relative path
            vrel = str(md_path).replace(str(vault_root) + "/", "")

            # Classify domain from path
            domain = classify_domain_from_path(str(md_path))

            # Extract title (first # heading or filename)
            title = md_path.stem
            for line in content.split("\n")[:20]:
                if line.startswith("# ") and not line.startswith("# ---"):
                    title = line[2:].strip()
                    break

            # Extract frontmatter (everything between first --- and second ---)
            frontmatter = None
            if content.startswith("---"):
                end = content.find("---", 3)
                if end > 0:
                    frontmatter = content[3:end].strip()
            # Also handle field:: value style (no --- delimiters)
            elif content and "::" in content.split("\n")[0]:
                fm_lines = []
                for line in content.split("\n"):
                    if "::" in line:
                        fm_lines.append(line)
                    elif line.strip() == "" and fm_lines:
                        break
                    elif line.startswith("#"):
                        break
                    else:
                        break
                if fm_lines:
                    frontmatter = "\n".join(fm_lines)

            # Word count
            words = len(content.split())

            # File creation time
            try:
                created_at = datetime.fromtimestamp(
                    md_path.stat().st_birthtime, tz=timezone.utc
                ).isoformat()
            except (AttributeError, OSError):
                created_at = fmtime

            # Upsert into vault_files
            # Need to handle the FTS triggers properly for updates
            existing_row = conn.execute(
                "SELECT id FROM vault_files WHERE file_path = ?",
                (str(md_path),)
            ).fetchone()

            if existing_row:
                # Update existing — triggers handle FTS sync
                conn.execute(
                    """UPDATE vault_files SET
                        vault_relative = ?, domain = ?, title = ?,
                        frontmatter = ?, content_text = ?,
                        char_count = ?, word_count = ?,
                        file_hash = ?, file_mtime = ?, file_size = ?,
                        harvested_at = ?, harvest_version = ?
                       WHERE file_path = ?""",
                    (vrel, domain, title, frontmatter, content,
                     len(content), words, fhash, fmtime, fsize,
                     datetime.now(timezone.utc).isoformat(), SCHEMA_VERSION,
                     str(md_path))
                )
                stats["updated"] += 1
            else:
                # Insert new
                conn.execute(
                    """INSERT INTO vault_files
                       (file_path, vault_relative, domain, title,
                        frontmatter, content_text, char_count, word_count,
                        file_hash, file_mtime, file_size, created_at,
                        harvested_at, harvest_version)
                       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
                    (str(md_path), vrel, domain, title,
                     frontmatter, content, len(content), words,
                     fhash, fmtime, fsize, created_at,
                     datetime.now(timezone.utc).isoformat(), SCHEMA_VERSION)
                )
                stats["indexed"] += 1

            # Commit in batches
            if i % 100 == 0:
                conn.commit()
                pct = int(i / total * 100)
                sys.stdout.write(f"\r  [{pct:3d}%] {i}/{total} — {stats['indexed']} new, {stats['updated']} updated, {stats['skipped']} unchanged")
                sys.stdout.flush()

        except Exception as e:
            stats["errors"] += 1
            if stats["errors"] <= 5:
                print(f"\n  ERROR: {md_path.name}: {e}")

    conn.commit()
    print(f"\r  [100%] {total}/{total} — {stats['indexed']} new, {stats['updated']} updated, {stats['skipped']} unchanged")

    return stats


def cmd_harvest(args):
    """Ingest JSONL transcripts and vault files into the database."""
    conn = get_db()

    # Ensure schema exists
    conn.executescript(SCHEMA_SQL)
    conn.executescript(SEED_PRICING_SQL)
    conn.commit()

    source = args.source

    # ── JSONL Transcripts ──
    if source in ("claude-code", "all"):
        if args.session:
            jsonl_files = [PROJECTS_DIR / f"{args.session}.jsonl"]
            jsonl_files = [f for f in jsonl_files if f.exists()]
        else:
            jsonl_files = sorted(
                [f for f in PROJECTS_DIR.iterdir() if f.suffix == ".jsonl" and f.is_file()],
                key=lambda p: p.stat().st_mtime
            )

        if args.since:
            cutoff = datetime.strptime(args.since, "%Y-%m-%d").replace(tzinfo=timezone.utc)
            jsonl_files = [
                f for f in jsonl_files
                if datetime.fromtimestamp(f.stat().st_mtime, tz=timezone.utc) >= cutoff
            ]

        total = len(jsonl_files)
        harvested = 0
        skipped = 0
        total_msgs = 0
        total_tools = 0
        errors = 0

        print(f"[transcripts] {total} JSONL file(s)")

        for i, jf in enumerate(jsonl_files, 1):
            try:
                result = harvest_jsonl(conn, jf, dry_run=args.dry_run, force=args.full)
                if result["skipped"]:
                    skipped += 1
                else:
                    harvested += 1
                    total_msgs += result["messages"]
                    total_tools += result["tool_uses"]
                    errors += result["errors"]
                    conn.commit()

                if i % 10 == 0 or i == total:
                    pct = int(i / total * 100)
                    sys.stdout.write(f"\r  [{pct:3d}%] {i}/{total} — {harvested} harvested, {skipped} skipped")
                    sys.stdout.flush()

            except Exception as e:
                errors += 1
                print(f"\n  ERROR: {jf.name}: {e}")
                conn.execute(
                    "INSERT OR REPLACE INTO harvest_log (file_path, file_hash, file_size, harvested_at, status, error_text, harvest_version) VALUES (?, '', 0, ?, 'error', ?, ?)",
                    (str(jf), datetime.now(timezone.utc).isoformat(), str(e), SCHEMA_VERSION)
                )
                conn.commit()

        print()

        if harvested > 0 and not args.dry_run:
            print("  Building concurrency groups...")
            build_concurrency_groups(conn)
            conn.commit()

        print(f"  Transcripts: {harvested} harvested, {skipped} unchanged, {errors} errors")
        print(f"  Messages: {total_msgs:,} | Tool uses: {total_tools:,}")

    # ── Vault Files ──
    if source in ("vault", "all"):
        print(f"\n[vault] Indexing Obsidian vault...")
        vault_stats = harvest_vault_files(
            conn, VAULT_ROOT,
            dry_run=args.dry_run,
            force=args.full,
            since=args.since,
        )
        print(f"  Vault: {vault_stats['indexed']} new, {vault_stats['updated']} updated, "
              f"{vault_stats['skipped']} unchanged, {vault_stats['errors']} errors")

    # Final summary
    db_size = DB_PATH.stat().st_size if DB_PATH.exists() else 0
    vault_count = conn.execute("SELECT COUNT(*) FROM vault_files").fetchone()[0]
    session_count = conn.execute("SELECT COUNT(*) FROM sessions").fetchone()[0]
    msg_count = conn.execute("SELECT COUNT(*) FROM messages").fetchone()[0]
    print(f"\n  DB: {db_size / 1024 / 1024:.1f} MB | {session_count} sessions | {msg_count:,} messages | {vault_count:,} vault files")

    conn.close()


