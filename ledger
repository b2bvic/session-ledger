def cmd_search(args):
    """Full-text search across all session content."""
    conn = get_db()
    query = args.query

    limit = args.limit or 20

    sql = """
        SELECT
            fu.source_type,
            fu.session_uuid,
            fu.domain,
            fu.timestamp,
            snippet(fts_unified, 4, '>>>', '<<<', '...', 40) AS snippet,
            rank
        FROM fts_unified fu
        WHERE fts_unified MATCH ?
    """
    params = [query]

    if args.domain:
        sql += " AND fu.domain = ?"
        params.append(args.domain)

    if args.since:
        sql += " AND fu.timestamp >= ?"
        params.append(args.since)

    sql += " ORDER BY rank LIMIT ?"
    params.append(limit)

    rows = conn.execute(sql, params).fetchall()

    if not rows:
        print(f"No results for: {query}")
        conn.close()
        return

    if args.format == "json":
        results = [dict(r) for r in rows]
        print(json.dumps(results, indent=2))
    else:
        print(f"\n  {len(rows)} result(s) for: {query}\n")
        for r in rows:
            domain = r["domain"] or "?"
            src = r["source_type"]
            ts = r["timestamp"][:10] if r["timestamp"] else "?"
            snippet = r["snippet"]
            uuid_short = r["session_uuid"][:8] if r["session_uuid"] else "?"
            print(f"  [{domain}] {ts} ({src}) [{uuid_short}]")
            print(f"    {snippet}")
            print()

    conn.close()


