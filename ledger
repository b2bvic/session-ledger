def cmd_query(args):
    """Run arbitrary SQL against the database."""
    conn = get_db()
    sql = args.sql

    try:
        rows = conn.execute(sql).fetchall()
        if not rows:
            print("(no results)")
            conn.close()
            return

        if args.format == "json":
            print(json.dumps([dict(r) for r in rows], indent=2))
        elif args.format == "csv":
            keys = rows[0].keys()
            print(",".join(keys))
            for r in rows:
                print(",".join(str(r[k]) for k in keys))
        else:
            # Table format
            keys = rows[0].keys()
            widths = {k: max(len(k), max(len(str(r[k] or "")[:50]) for r in rows)) for k in keys}
            header = "  ".join(k.ljust(widths[k])[:50] for k in keys)
            print(header)
            print("  ".join("─" * min(widths[k], 50) for k in keys))
            for r in rows:
                line = "  ".join(str(r[k] or "")[:50].ljust(widths[k])[:50] for k in keys)
                print(line)
    except sqlite3.Error as e:
        print(f"SQL error: {e}")

    conn.close()


