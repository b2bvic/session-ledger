def _root_status(name: str, path: Path, available: bool, reason: "str | None" = None) -> dict:
    return {
        "name": name,
        "path": str(path),
        "available": available,
        "reason": reason,
    }


def discover_claude_project_dirs() -> tuple:
    """Return (project_dirs, root_status). LEDGER_PROJECT limits discovery to one dir."""
    override = os.environ.get("LEDGER_PROJECT")
    if override:
        path = Path(override)
        if _path_is_dir(path):
            return [path], _root_status("claude-project", path, True)
        reason = "missing" if not _path_exists(path) else "not a directory"
        return [], _root_status("claude-project", path, False, reason)

    root = get_claude_projects_root()
    if not _path_exists(root):
        return [], _root_status("claude-projects", root, False, "missing")
    if not _path_is_dir(root):
        return [], _root_status("claude-projects", root, False, "not a directory")
    dirs = sorted(
        [d for d in root.iterdir() if d.is_dir() and not d.name.startswith(".")],
        key=lambda p: p.name,
    )
    return dirs, _root_status("claude-projects", root, True)


def discover_claude_session_files(project_dirs: list) -> list:
    """Top-level *.jsonl files in each Claude project directory."""
    found = []
    for project_dir in project_dirs:
        try:
            entries = sorted(project_dir.iterdir(), key=lambda p: p.name)
        except OSError as error:
            raise OSError(f"Cannot discover project {project_dir}: {error}") from error
        for entry in entries:
            if entry.is_file() and entry.suffix == ".jsonl":
                found.append({"path": entry, "project_path": project_dir, "kind": "session"})
    return found


def discover_codex_jsonl(codex_root: Path) -> tuple:
    """Recursive JSONL under sessions/ and archived_sessions/ only."""
    if not _path_exists(codex_root):
        return [], _root_status("codex", codex_root, False, "missing")
    if not _path_is_dir(codex_root):
        return [], _root_status("codex", codex_root, False, "not a directory")

    files = []
    children = []
    def fail(error):
        raise error
    for sub in ("sessions", "archived_sessions"):
        folder = codex_root / sub
        available = folder.is_dir()
        children.append(_root_status(f"codex-{sub}", folder, available, None if available else "missing or not a directory"))
        if not available:
            continue
        for parent, dirs, names in os.walk(folder, followlinks=False, onerror=fail):
            dirs.sort()
            files.extend(Path(parent) / name for name in sorted(names) if name.endswith(".jsonl"))
    status = _root_status("codex", codex_root, True)
    status["children"] = children
    return files, status


def discover_subagent_files(session_jsonl: Path) -> list:
    """Nested agent JSONL under <session-uuid>/..., including deeper subagents."""
    session_dir = session_jsonl.parent / session_jsonl.stem
    if not session_dir.is_dir():
        return []
    found = []
    def fail(error):
        raise error
    for parent, dirs, names in os.walk(session_dir, followlinks=False, onerror=fail):
        dirs.sort()
        found.extend(Path(parent) / name for name in sorted(names) if name.endswith(".jsonl"))
    return found


def _agent_id_from_subagent_path(path: Path) -> str:
    match = re.match(r"agent-(.+)\.jsonl$", path.name)
    if match:
        return match.group(1)
    return path.stem


