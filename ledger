def file_sha256(filepath: Path) -> str:
    h = hashlib.sha256()
    with open(filepath, "rb") as f:
        for chunk in iter(lambda: f.read(8192), b""):
            h.update(chunk)
    return h.hexdigest()


def parse_timestamp(ts) -> "str | None":
    """Convert any timestamp format to ISO 8601 UTC string."""
    if not ts:
        return None
    try:
        if isinstance(ts, str):
            dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
            return dt.astimezone(timezone.utc).isoformat()
        if isinstance(ts, (int, float)):
            epoch = ts / 1000 if ts > 1e12 else ts
            dt = datetime.fromtimestamp(epoch, tz=timezone.utc)
            return dt.astimezone(timezone.utc).isoformat()
    except (ValueError, OSError, OverflowError):
        pass
    return None


def extract_text_content(content) -> "str | None":
    """Extract human-readable text from message content field."""
    if isinstance(content, str):
        return content.strip() or None
    if isinstance(content, list):
        texts = []
        for block in content:
            if not isinstance(block, dict):
                continue
            if block.get("type") in ("text", "input_text", "output_text"):
                t = (block.get("text") or "").strip()
                if t:
                    texts.append(t)
        return "\n\n".join(texts) if texts else None
    return None


def extract_tool_uses_from_content(content) -> list[dict]:
    """Extract tool_use blocks from assistant message content."""
    if not isinstance(content, list):
        return []
    tools = []
    for block in content:
        if isinstance(block, dict) and block.get("type") == "tool_use":
            tool = {
                "tool_use_id": block.get("id", ""),
                "tool_name": block.get("name", ""),
                "input": block.get("input", {}),
            }
            # Extract denormalized fields for common tools
            inp = tool["input"]
            if isinstance(inp, dict):
                tool["file_path"] = inp.get("file_path") or inp.get("path")
                tool["command"] = inp.get("command")
                tool["pattern"] = inp.get("pattern")
                tool["description"] = inp.get("description")
            tools.append(tool)
    return tools


def extract_tool_results(content) -> list[dict]:
    """Extract tool_result blocks from user messages (tool returns)."""
    if not isinstance(content, list):
        return []
    results = []
    for block in content:
        if isinstance(block, dict) and block.get("type") == "tool_result":
            result_content = block.get("content", "")
            if isinstance(result_content, list):
                texts = []
                for rb in result_content:
                    if isinstance(rb, dict) and rb.get("type") == "text":
                        texts.append(rb.get("text", ""))
                result_content = "\n".join(texts)
            results.append({
                "tool_use_id": block.get("tool_use_id", ""),
                "content": str(result_content)[:10000],  # cap at 10K chars
                "is_error": block.get("is_error", False),
            })
    return results


def classify_domain_from_text(text: str) -> "str | None":
    """Classify domain from message text using keyword matching."""
    if not text:
        return None
    text_lower = text.lower()
    scores = {}
    for domain, keywords in DOMAIN_KEYWORDS.items():
        count = sum(1 for kw in keywords if kw in text_lower)
        if count > 0:
            scores[domain] = count
    if not scores:
        return None
    return max(scores, key=scores.get)


def classify_domain_from_path(filepath: str) -> "str | None":
    """Classify domain from a vault file path."""
    if not filepath:
        return None
    for domain, pattern in DOMAIN_PATHS.items():
        if pattern in filepath:
            return domain
    return None


def vault_relative_path(filepath: str) -> "str | None":
    """Convert absolute path to vault-relative path."""
    if not filepath:
        return None
    root = get_vault_root()
    if root is None:
        return None
    vault_str = str(root) + "/"
    if filepath.startswith(vault_str):
        return filepath[len(vault_str):]
    return None


def qualify_id(provider: str, native_id) -> "str | None":
    """Return a stored identity. Claude IDs stay unqualified. Codex IDs get a prefix."""
    if native_id is None:
        return None
    native = str(native_id).strip()
    if not native:
        return None
    if provider in (None, "", "claude-code"):
        return native
    prefix = f"{provider}:"
    if native.startswith(prefix):
        return native
    return prefix + native


def load_jsonl_records(jsonl_path: Path) -> tuple:
    records = []
    errors = 0
    with open(jsonl_path, "r", encoding="utf-8") as f:
        for line in f:
            stripped = line.strip()
            if not stripped:
                continue
            try:
                value = json.loads(stripped)
                if not isinstance(value, dict):
                    errors += 1
                else:
                    records.append(value)
            except json.JSONDecodeError:
                errors += 1
    return records, errors


def detect_transcript_format(records: list) -> str:
    """Return claude-code, codex, or unknown from native record types."""
    for rec in records:
        if not isinstance(rec, dict):
            continue
        rtype = rec.get("type")
        if rtype in ("session_meta", "response_item", "event_msg", "turn_context"):
            return "codex"
        if rtype in (
            "user",
            "assistant",
            "system",
            "progress",
            "file-history-snapshot",
            "queue-operation",
            "last-prompt",
        ):
            return "claude-code"
    return "unknown"


def extract_codex_session_id(records: list) -> "str | None":
    """Read the source session UUID from session_meta. Do not use the rollout filename."""
    for rec in records:
        if not isinstance(rec, dict) or rec.get("type") != "session_meta":
            continue
        payload = rec.get("payload")
        if not isinstance(payload, dict):
            payload = rec
        sid = payload.get("id") or payload.get("session_id")
        if sid:
            return str(sid)
    return None


def _payload(record: dict) -> dict:
    payload = record.get("payload")
    return payload if isinstance(payload, dict) else {}


def _norm_path(path) -> str:
