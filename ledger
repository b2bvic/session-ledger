def estimate_cost(model: str, input_tok: int, output_tok: int,
                  cache_create: int = 0, cache_read: int = 0) -> float:
    """Estimate API cost in USD for a message."""
    pricing = MODEL_PRICING.get(model)
    if not pricing:
        return 0.0
    cost = (
        input_tok * pricing["input"] / 1_000_000
        + output_tok * pricing["output"] / 1_000_000
        + cache_create * pricing["cache_create"] / 1_000_000
        + cache_read * pricing["cache_read"] / 1_000_000
    )
    return cost


