def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="ledger",
        description="Session Ledger — Claude and Codex session transcript database",
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    parser.add_argument("--db", type=Path, default=DB_PATH, help="Database path")
    parser.add_argument("--format", choices=["table", "json", "csv"], default="table")

    sub = parser.add_subparsers(dest="command")

    # init
    sub.add_parser("init", help="Create/migrate database schema")

    # harvest
    h = sub.add_parser("harvest", help="Ingest JSONL transcripts")
    h.add_argument(
        "--source",
        choices=["claude-code", "codex", "vault", "all"],
        default="claude-code",
        help="Source to harvest (default: claude-code)",
    )
    h.add_argument("--full", action="store_true", help="Force re-harvest all files")
    h.add_argument("--dry-run", action="store_true", help="Preview without writing")
    h.add_argument("--since", help="Only files modified after YYYY-MM-DD")
    h.add_argument("--session", help="Harvest specific session UUID")

    # search
    s = sub.add_parser("search", help="Full-text search")
    s.add_argument("query", help="Search query")
    s.add_argument("--domain", help="Filter by domain")
    s.add_argument("--since", help="Results after YYYY-MM-DD")
    s.add_argument("--limit", type=int, default=20)

    # sessions
    ss = sub.add_parser("sessions", help="List and inspect sessions")
    ss.add_argument("subcmd", nargs="?", default="list", choices=["list", "show", "concurrent"])
    ss.add_argument("uuid", nargs="?", help="Session UUID (for show)")
    ss.add_argument("--domain", help="Filter by domain")
    ss.add_argument("--since", help="Sessions after YYYY-MM-DD")
    ss.add_argument("--limit", type=int, default=20)

    # files
    fs = sub.add_parser("files", help="File operation tracking")
    fs.add_argument("subcmd", nargs="?", default="hot", choices=["hot", "trail"])
    fs.add_argument("file", nargs="?", help="File path (for trail)")
    fs.add_argument("--limit", type=int, default=20)

    # stats
    st = sub.add_parser("stats", help="Usage statistics")
    st.add_argument("subcmd", nargs="?", default="overview",
                     choices=["overview", "daily", "domains", "tools", "models"])
    st.add_argument("--limit", type=int, default=14)

    # status
    sub.add_parser("status", help="Database health")

    # export
    ex = sub.add_parser("export", help="Write shared records as JSON")
    ex.add_argument("--session", help="Session UUID or native id prefix")
    ex.add_argument("--out", type=Path, help="Output file (default: stdout)")
    ex.add_argument("--pretty", action="store_true", help="Indent JSON output")

    # query
    q = sub.add_parser("query", help="Run SQL query")
    q.add_argument("sql", help="SQL statement")

    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()

    # Override DB path if specified
    global DB_PATH
    if args.db != DB_PATH:
        DB_PATH = args.db

    if args.command == "init":
        cmd_init(args)
    elif args.command == "harvest":
        raise SystemExit(cmd_harvest(args))
    elif args.command == "search":
        cmd_search(args)
    elif args.command == "sessions":
        cmd_sessions(args)
    elif args.command == "files":
        cmd_files(args)
    elif args.command == "stats":
        cmd_stats(args)
    elif args.command == "status":
        cmd_status(args)
    elif args.command == "export":
        cmd_export(args)
    elif args.command == "query":
        cmd_query(args)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
