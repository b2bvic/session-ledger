def _ts_or_now(timestamp) -> str:
    return timestamp or ""  # Unknown source time stays unknown, never harvest time.


def _clear_session_children(conn: sqlite3.Connection, session_id: int):
    # Replace this session's search snapshot within the harvest savepoint.
    conn.execute(
        """DELETE FROM fts_unified
           WHERE session_uuid = (SELECT session_uuid FROM sessions WHERE id = ?)
             AND source_type IN ('user_message', 'assistant_message', 'system_message')""",
        (session_id,),
    )
    conn.execute("DELETE FROM messages WHERE session_id = ?", (session_id,))
    conn.execute("DELETE FROM tool_uses WHERE session_id = ?", (session_id,))
    conn.execute("DELETE FROM file_operations WHERE session_id = ?", (session_id,))
    conn.execute("DELETE FROM compactions WHERE session_id = ?", (session_id,))
    conn.execute("DELETE FROM subagents WHERE session_id = ?", (session_id,))


def _open_session_row(
    conn: sqlite3.Connection,
    *,
    session_uuid: str,
    source: str,
    provider: str,
    native_session_id: str,
    parent_id,
    project_path,
    jsonl_path: Path,
    started_at: str,
    raw_line_count: int,
    existing,
) -> int:
    now = datetime.now(timezone.utc).isoformat()
    project_str = str(project_path) if project_path else None
    path_str = str(jsonl_path)
    if existing:
        session_id = existing["id"]
        _clear_session_children(conn, session_id)
        conn.execute(
            """UPDATE sessions SET
                 provider = ?, native_session_id = ?, parent_id = ?,
                 project_path = ?, jsonl_path = ?, source_path = ?,
                 is_harvested = 0, harvest_version = ?, harvested_at = ?,
                 raw_line_count = ?
               WHERE id = ?""",
            (
                provider,
                native_session_id,
                parent_id,
                project_str,
                path_str,
                path_str,
                SCHEMA_VERSION,
                now,
                raw_line_count,
                session_id,
            ),
        )
        return session_id
    conn.execute(
        """INSERT INTO sessions (
               session_uuid, source, provider, native_session_id, parent_id,
               project_path, jsonl_path, source_path, started_at,
               is_harvested, harvest_version, harvested_at, raw_line_count
           ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 0, ?, ?, ?)""",
        (
            session_uuid,
            source,
            provider,
            native_session_id,
            parent_id,
            project_str,
            path_str,
            path_str,
            started_at,
            SCHEMA_VERSION,
            now,
            raw_line_count,
        ),
    )
    return conn.execute("SELECT last_insert_rowid()").fetchone()[0]


