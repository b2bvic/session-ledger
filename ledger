# ---------------------------------------------------------------------------
# Database connection
# ---------------------------------------------------------------------------


def get_db(db_path: Path = None) -> sqlite3.Connection:
    path = db_path or DB_PATH
    path.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(str(path), timeout=10)
    conn.execute("PRAGMA journal_mode = WAL")
    conn.execute("PRAGMA foreign_keys = ON")
    conn.row_factory = sqlite3.Row
    try:
        has_meta = conn.execute(
            "SELECT 1 FROM sqlite_master WHERE type='table' AND name='schema_meta'"
        ).fetchone()
        if has_meta:
            ensure_schema(conn)
    except sqlite3.Error:
        pass
    return conn


ADDITIVE_COLUMNS = (
    ("sessions", "provider", "TEXT"),
    ("sessions", "native_session_id", "TEXT"),
    ("sessions", "parent_id", "TEXT"),
    ("sessions", "source_path", "TEXT"),
    ("messages", "native_id", "TEXT"),
    ("messages", "source_path", "TEXT"),
    ("tool_uses", "native_id", "TEXT"),
    ("harvest_log", "provider", "TEXT"),
    ("harvest_log", "source_path", "TEXT"),
)


def _table_columns(conn: sqlite3.Connection, table: str) -> set:
    rows = conn.execute(f"PRAGMA table_info({table})").fetchall()
    return {r[1] for r in rows}


def migrate_schema(conn: sqlite3.Connection):
    """Apply additive schema changes without rebuilding existing tables."""
    for table, column, col_type in ADDITIVE_COLUMNS:
        try:
            existing = _table_columns(conn, table)
        except sqlite3.Error:
            continue
        if not existing or column in existing:
            continue
        conn.execute(f"ALTER TABLE {table} ADD COLUMN {column} {col_type}")

    if "sessions" in {
        r[0] for r in conn.execute(
            "SELECT name FROM sqlite_master WHERE type='table'"
        ).fetchall()
    }:
        conn.execute(
            "UPDATE sessions SET provider = source WHERE provider IS NULL AND source IS NOT NULL"
        )
        conn.execute(
            "UPDATE sessions SET native_session_id = session_uuid "
            "WHERE native_session_id IS NULL AND session_uuid IS NOT NULL"
        )
        conn.execute(
            "UPDATE sessions SET source_path = jsonl_path "
            "WHERE source_path IS NULL AND jsonl_path IS NOT NULL"
        )
        conn.execute(
            "UPDATE messages SET native_id = uuid WHERE native_id IS NULL AND uuid IS NOT NULL"
        )
        conn.execute(
            "UPDATE tool_uses SET native_id = tool_use_id "
            "WHERE native_id IS NULL AND tool_use_id IS NOT NULL"
        )

    conn.execute(
        "INSERT OR REPLACE INTO schema_meta (key, value) VALUES (?, ?)",
        ("schema_version", str(SCHEMA_VERSION)),
    )


def ensure_schema(conn: sqlite3.Connection):
    if conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='sessions'").fetchone():
        migrate_schema(conn)
    conn.executescript(SCHEMA_SQL)
    conn.executescript(SEED_PRICING_SQL)
    migrate_schema(conn)
    conn.commit()


# ---------------------------------------------------------------------------
# Init command
# ---------------------------------------------------------------------------


def cmd_init(args):
    """Create or migrate the database schema."""
    conn = get_db()
    try:
        ensure_schema(conn)
        conn.execute(
            "INSERT OR REPLACE INTO schema_meta (key, value) VALUES (?, ?)",
            ("created_at", datetime.now(timezone.utc).isoformat()),
        )
        conn.commit()
        print(f"Database initialized at {DB_PATH}")
        print(f"  Schema version: {SCHEMA_VERSION}")
        print(f"  Size: {DB_PATH.stat().st_size / 1024:.1f} KB")
    finally:
        conn.close()


