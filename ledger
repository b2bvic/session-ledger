def cmd_status(args):
    """Database health and harvest status."""
    conn = get_db()

    db_size = DB_PATH.stat().st_size if DB_PATH.exists() else 0
    schema_v = conn.execute(
        "SELECT value FROM schema_meta WHERE key = 'schema_version'"
    ).fetchone()
    schema_v = schema_v[0] if schema_v else "?"

    sessions = conn.execute("SELECT COUNT(*) FROM sessions").fetchone()[0]
    messages = conn.execute("SELECT COUNT(*) FROM messages").fetchone()[0]
    tools = conn.execute("SELECT COUNT(*) FROM tool_uses").fetchone()[0]

    harvested = conn.execute(
        "SELECT COUNT(*) FROM harvest_log WHERE status = 'complete'"
    ).fetchone()[0]
    errored = conn.execute(
        "SELECT COUNT(*) FROM harvest_log WHERE status = 'error'"
    ).fetchone()[0]
    last_harvest = conn.execute(
        "SELECT MAX(harvested_at) FROM harvest_log"
    ).fetchone()[0]

    project_dirs, claude_root = discover_claude_project_dirs()
    claude_files = discover_claude_session_files(project_dirs)
    codex_files, codex_root = discover_codex_jsonl(get_codex_dir())
    vault_root = get_vault_root()
    if vault_root is None:
        vault_status = _root_status("vault", Path("LEDGER_VAULT"), False, "not configured")
    elif not _path_exists(vault_root):
        vault_status = _root_status("vault", vault_root, False, "missing")
    elif not _path_is_dir(vault_root):
        vault_status = _root_status("vault", vault_root, False, "not a directory")
    else:
        vault_status = _root_status("vault", vault_root, True)

    total_jsonl = len(claude_files) + len(codex_files)
    total_jsonl_size = 0
    for item in claude_files:
        try:
            total_jsonl_size += item["path"].stat().st_size
        except OSError:
            pass
    for path in codex_files:
        try:
            total_jsonl_size += path.stat().st_size
        except OSError:
            pass

    print(f"\n  Session Ledger — Status")
    print(f"  {'─'*40}")
    print(f"  DB path:       {DB_PATH}")
    print(f"  DB size:       {db_size / 1024 / 1024:.1f} MB")
    print(f"  Schema:        v{schema_v}")
    print(f"  Sessions:      {sessions:,}")
    print(f"  Messages:      {messages:,}")
    print(f"  Tool uses:     {tools:,}")
    print(f"  Harvested:     {harvested} files")
    print(f"  Errors:        {errored} files")
    print(f"  Last harvest:  {last_harvest or 'never'}")
    print("  Configured roots:")
    for root in (claude_root, codex_root, vault_status):
        state = "available" if root["available"] else f"unavailable ({root['reason']})"
        print(f"    {root['name']}: {root['path']} — {state}")
    print(f"  JSONL source:  {total_jsonl} files, {total_jsonl_size / 1024 / 1024:.1f} MB")
    print(f"  Pending:       ~{total_jsonl - harvested} files")
    if total_jsonl == 0:
        print("  Note: 0 discovered files is not evidence of complete coverage.")

    conn.close()


