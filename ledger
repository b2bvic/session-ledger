def _path_exists(path: Path) -> bool:
    try:
        return path.exists()
    except OSError:
        return False


def _path_is_dir(path: Path) -> bool:
    try:
        return path.is_dir()
    except OSError:
        return False


def _find_project_dir():
    """Return LEDGER_PROJECT, else the newest Claude project, else the projects root.

    Harvest no longer uses this as the sole discovery path. Default harvest
    walks every project directory. This helper remains for status fallbacks
    and import-time compatibility.
    """
    projects = get_claude_projects_root()
    override = os.environ.get("LEDGER_PROJECT")
    if override:
        return Path(override)
    try:
        if not _path_is_dir(projects):
            return projects
        dirs = sorted(projects.iterdir(), key=lambda p: p.stat().st_mtime, reverse=True)
        for d in dirs:
            if d.is_dir() and not d.name.startswith("."):
                return d
    except OSError:
        return projects
    return projects


