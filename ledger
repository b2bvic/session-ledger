def _omit_empty(value):
    if value is None:
        return True
    if value == "":
        return True
    if value == {}:
        return True
    if value == []:
        return True
    return False


def _strip_empty(obj):
    if isinstance(obj, dict):
        return {k: _strip_empty(v) for k, v in obj.items() if not _omit_empty(v)}
    if isinstance(obj, list):
        return [_strip_empty(v) for v in obj]
    return obj


def shared_record_for_session(conn: sqlite3.Connection, row) -> dict:
    """Build a shared export record from stored columns. Do not invent values."""
    session_pk = row["id"] if "id" in row.keys() else None
    if session_pk is None:
        session_pk = conn.execute(
            "SELECT id FROM sessions WHERE session_uuid = ? AND source = ?",
            (row["session_uuid"], row["source"]),
        ).fetchone()[0]
    messages = conn.execute(
        "SELECT * FROM messages WHERE session_id = ? ORDER BY sequence_num, id",
        (session_pk,),
    ).fetchall()
    tools = conn.execute(
        "SELECT * FROM tool_uses WHERE session_id = ? ORDER BY id",
        (session_pk,),
    ).fetchall()
    tools_by_msg = {}
    for tool in tools:
        tools_by_msg.setdefault(tool["message_id"], []).append(tool)

    out_messages = []
    for msg in messages:
        rec = {
            "source_record": json.loads(msg["raw_json"]) if msg["raw_json"] else None,
            "id": msg["uuid"],
            "native_id": msg["native_id"] if "native_id" in msg.keys() else None,
            "parent_id": msg["parent_uuid"],
            "role": msg["role"],
            "timestamp": msg["timestamp"],
            "text": msg["content_text"],
            "model": msg["model"],
            "source_path": msg["source_path"] if "source_path" in msg.keys() else None,
        }
        msg_tools = tools_by_msg.get(msg["id"], [])
        if msg_tools:
            rec["tool_calls"] = []
            for tool in msg_tools:
                raw_input = tool["input_json"]
                parsed_input = None
                if raw_input:
                    try:
                        parsed_input = json.loads(raw_input)
                    except json.JSONDecodeError:
                        parsed_input = raw_input
                rec["tool_calls"].append(
                    {
                        "id": tool["tool_use_id"],
                        "native_id": tool["native_id"] if "native_id" in tool.keys() else None,
                        "name": tool["tool_name"],
                        "input": parsed_input,
                        "output": tool["result_text"],
                        "is_error": bool(tool["is_error"]) if tool["is_error"] is not None else None,
                    }
                )
        out_messages.append(rec)

    record = {
        "provider": (row["provider"] if "provider" in row.keys() else None) or row["source"],
        "session_id": row["session_uuid"],
        "native_session_id": row["native_session_id"] if "native_session_id" in row.keys() else None,
        "parent_id": row["parent_id"] if "parent_id" in row.keys() else None,
        "source_path": (row["source_path"] if "source_path" in row.keys() else None)
        or row["jsonl_path"]
        if "jsonl_path" in row.keys()
        else None,
        "started_at": row["started_at"],
        "ended_at": row["ended_at"] if "ended_at" in row.keys() else None,
        "model": row["primary_model"] if "primary_model" in row.keys() else None,
        "messages": out_messages,
    }
    return _strip_empty(record)


def cmd_export(args):
    """Write shared records as JSON."""
    conn = get_db()
    sql = "SELECT * FROM sessions"
    params = []
    if args.session:
        sql += " WHERE session_uuid LIKE ? OR native_session_id LIKE ?"
        params.extend([f"{args.session}%", f"{args.session}%"])
    sql += " ORDER BY started_at"
    rows = conn.execute(sql, params).fetchall()
    records = [shared_record_for_session(conn, row) for row in rows]
    indent = 2 if args.pretty or args.format == "json" else None
    payload = json.dumps(records, indent=indent, ensure_ascii=False)
    if args.out:
        Path(args.out).write_text(payload + "\n", encoding="utf-8")
        print(f"Wrote {len(records)} record(s) to {args.out}")
    else:
        print(payload)
    conn.close()


def cmd_query(args):
    """Run arbitrary SQL against the database."""
    conn = get_db()
    sql = args.sql

    try:
        rows = conn.execute(sql).fetchall()
        if not rows:
            print("(no results)")
            conn.close()
            return

        if args.format == "json":
            print(json.dumps([dict(r) for r in rows], indent=2))
        elif args.format == "csv":
            keys = rows[0].keys()
            print(",".join(keys))
            for r in rows:
                print(",".join(str(r[k]) for k in keys))
        else:
            # Table format
            keys = rows[0].keys()
            widths = {k: max(len(k), max(len(str(r[k] or "")[:50]) for r in rows)) for k in keys}
            header = "  ".join(k.ljust(widths[k])[:50] for k in keys)
            print(header)
            print("  ".join("─" * min(widths[k], 50) for k in keys))
            for r in rows:
                line = "  ".join(str(r[k] or "")[:50].ljust(widths[k])[:50] for k in keys)
                print(line)
    except sqlite3.Error as e:
        print(f"SQL error: {e}")

    conn.close()


